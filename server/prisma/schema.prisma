  REJECTED
  RETURNED_TO_IMPUTER
}

model AuthorizationAuditTrail {
  id              String                   @id @default(uuid())
  entityType      AuthorizationEntityType
  entityId        String
  
  imputerId       String
  imputer         User                     @relation("ImputedAuditTrails", fields: [imputerId], references: [id])
