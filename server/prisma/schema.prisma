// ─────────────────────────────────────────────────────────────────────────────
//  INSTITUTIONAL DOCKET ROUTING WORKFLOW (STAFF -> DIRECTOR -> REGISTRY -> REGISTRAR)
// ─────────────────────────────────────────────────────────────────────────────

enum ApplicationCategory {
  POSTING_REQUEST
  CONCURRENCE
  STUDY_FELLOWSHIP
  SPECIAL_CLEARANCE
  GENERAL_MEMORANDUM
  ADMINISTRATIVE_APPEAL
}

enum InstitutionalApplicationStatus {
  SUBMITTED_TO_DIRECTOR
  RETURNED_FOR_REWRITE
  REJECTED_BY_DIRECTOR
  RECOMMENDED_TO_REGISTRY
  DOCKETED_PENDING_REGISTRAR
  APPROVED_BY_REGISTRAR
  DECLINED_BY_REGISTRAR
}

enum ApplicationHolderRole {
  STAFF
  DIRECTOR
  REGISTRY_ADMIN
  REGISTRAR
}

enum ApplicationRevisionAction {
  SUBMITTED
  REWRITE_REQUESTED
  RECOMMENDED
  DOCKET_ACKNOWLEDGED
  APPROVED
  DECLINED
}

enum ApplicationArchiveFinalStatus {
  APPROVED
  DECLINED
  REJECTED_BY_DIRECTOR
}

model InstitutionalApplication {
  id                     String                         @id @default(uuid())
  referenceNumber        String                         @unique
  applicantId            String
  applicant              User                           @relation("InstitutionalApplicant", fields: [applicantId], references: [id])
  directorId             String
  director               User                           @relation("InstitutionalDirector", fields: [directorId], references: [id])
  registrarId            String?
  registrar              User?                          @relation("InstitutionalRegistrar", fields: [registrarId], references: [id])
  registryClerkId        String?
  registryClerk          User?                          @relation("InstitutionalRegistryClerk", fields: [registryClerkId], references: [id])
  subject                String
  category               ApplicationCategory
  content                String                         @db.Text
  attachmentUrls         String[]
  status                 InstitutionalApplicationStatus @default(SUBMITTED_TO_DIRECTOR)
  currentHolderRole      ApplicationHolderRole          @default(DIRECTOR)
  directorRemarks        String?                        @db.Text
  directorRecommendedAt  DateTime?
  registryDocketNumber   String?                        @unique
  registryAcknowledgedAt DateTime?
  registrarRemarks       String?                        @db.Text
  registrarDecidedAt     DateTime?
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt

  revisions              ApplicationRevisionHistory[]
  archive                RegistryApplicationArchive?

  @@index([applicantId, status])
  @@index([directorId, status])
  @@index([status, currentHolderRole])
  @@index([registryDocketNumber])
  @@map("institutional_applications")
}

model ApplicationRevisionHistory {
  id              String                    @id @default(uuid())
  applicationId   String
  application     InstitutionalApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actorId         String
  actor           User                      @relation("ApplicationRevisionActor", fields: [actorId], references: [id])
  stage           String
  action          ApplicationRevisionAction
  comments        String?                   @db.Text
  snapshotContent String?                   @db.Text
  createdAt       DateTime                  @default(now())

  @@index([applicationId])
  @@index([actorId])
  @@map("application_revision_histories")
}

model RegistryApplicationArchive {
  id                   String                        @id @default(uuid())
  applicationId        String                        @unique
  application          InstitutionalApplication      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  archivedDocketNumber String                        @unique
  finalStatus          ApplicationArchiveFinalStatus
  fullAuditCopy        Json
  archivedAt           DateTime                      @default(now())

  @@index([archivedDocketNumber])
  @@map("registry_application_archives")
}

// -------------------------------------------------------------
// FILE REQUISITION, CUSTODY TRACKING & RELEASE AUTHORIZATION
// -------------------------------------------------------------

enum FileRequisitionUrgency {
  ROUTINE
  URGENT
  STATUTORY_AUDIT
  LEGAL_SUBPOENA
}

enum FileRequestedFormat {
  PHYSICAL_HARDCOPY
  DIGITAL_TRANSCRIPT
  BOTH
}

enum FileRequisitionStatus {
  SUBMITTED
  ACKNOWLEDGED_PENDING_REGISTRAR
  REJECTED_BY_REGISTRY
  AUTHORIZED_BY_REGISTRAR
  DECLINED_BY_REGISTRAR
  DISPATCHED_RELEASED
  RETURNED_ARCHIVED
}

enum FileCustodyAction {
  REQUISITION_SUBMITTED
  ACKNOWLEDGED_AND_FORWARDED
  REGISTRAR_AUTHORIZED
  REGISTRAR_DECLINED
  FILE_DISPATCHED
  FILE_RETURN_LOGGED
}

model FileRequisition {
  id                         String                 @id @default(uuid())
  requisitionNumber          String                 @unique // e.g. "NOUN/REQ/FILE/2026/00318"
  staffProfileId             String
  staffProfile               StaffProfile           @relation("SubjectStaffFileRequisitions", fields: [staffProfileId], references: [id])
  requesterId                String
  requester                  User                   @relation("FileRequisitionsSubmitted", fields: [requesterId], references: [id])
  requesterDepartment        String
  purposeOfRequest           String                 @db.Text
  urgencyLevel               FileRequisitionUrgency @default(ROUTINE)
  requestedFileFormat        FileRequestedFormat    @default(PHYSICAL_HARDCOPY)
  expectedReturnDate         DateTime?
  status                     FileRequisitionStatus  @default(SUBMITTED)

  // Stage 2: Registry Acknowledgment & Folio
  acknowledgedById           String?
  acknowledgedBy             User?                  @relation("FileRequisitionsAcknowledged", fields: [acknowledgedById], references: [id])
  acknowledgedAt             DateTime?
  registryFolioReference     String?
  adminAcknowledgmentRemarks String?                @db.Text

  // Stage 3: Registrar Executive Authorization
  authorizedById             String?
  authorizedBy               User?                  @relation("FileRequisitionsAuthorized", fields: [authorizedById], references: [id])
  authorizedAt               DateTime?
  registrarRemarks           String?                @db.Text

  // Stage 4: Registry Physical Dispatch / Digital Access Token
  dispatchedById             String?
  dispatchedBy               User?                  @relation("FileRequisitionsDispatched", fields: [dispatchedById], references: [id])
  dispatchedAt               DateTime?
  dispatchReceiptNumber      String?                @unique // e.g. "NOUN/DISPATCH/2026/00091"
  trackingNotes              String?                @db.Text
  digitalAccessToken         String?
  digitalAccessExpiresAt     DateTime?

  // Stage 5: Custody Return & Re-Archiving
  returnedAt                 DateTime?
  receivingOfficerId         String?
  receivingOfficer           User?                  @relation("FileRequisitionsReceived", fields: [receivingOfficerId], references: [id])

  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt

  custodyAuditTrail          FileCustodyAuditTrail[]

  @@index([staffProfileId, status])
  @@index([requesterId, status])
  @@index([status])
  @@index([requisitionNumber])
  @@index([dispatchReceiptNumber])
  @@map("file_requisitions")
}

model FileCustodyAuditTrail {
  id            String            @id @default(uuid())
  requisitionId String
  requisition   FileRequisition   @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  action        FileCustodyAction
  actorId       String
  actor         User              @relation("FileCustodyAudits", fields: [actorId], references: [id])
  details       String?           @db.Text
  ipAddress     String?
  userAgent     String?
  metadata      Json?
  createdAt     DateTime          @default(now())

  @@index([requisitionId])
  @@index([actorId])
  @@map("file_custody_audit_trails")
}

model HrmsKnowledgeChunk {
  id             String   @id @default(uuid())
  cadre          String   // 'ACADEMIC', 'SENIOR_ADMIN', 'JUNIOR_STAFF', 'GENERAL'
  section        String   // 'LEAVE', 'DISCIPLINE', 'PROMOTIONS', 'EXIT', 'SALARIES', 'WORKLOAD', 'MANUAL', 'GENERAL'
  sourceDocument String   // e.g. "NOUN Rules and Regulations Senior Staff (June 2024)"
