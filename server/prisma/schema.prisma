
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  
  // Phase 3 Roles
  role      Role     @default(STAFF)
  
  isActive  Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  tokenInvalidatedAt DateTime? // Set when account is archived; blocks all existing JWTs
  
  // Dual-Control Role Modification Fields (Maker-Checker Governance)
  pendingRole              Role?
  roleChangeStatus         String?   // 'PENDING_REGISTRAR_APPROVAL', 'APPROVED', 'REJECTED'
  roleChangeRequestedById  String?
  roleChangeRequestedAt    DateTime?
  roleChangeRemarks        String?
  
  // Phase 15: 2FA
  twoFactorSecret    String?
  isTwoFactorEnabled Boolean  @default(false)
  twoFactorBackupCodes String? @db.Text
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  staffProfile StaffProfile?

  attendance   Attendance[]
  payroll      Payroll[]
  
  actionTrails DocumentTrail[]
  auditLogs    AuditLog[]
  
  // Relations for Workflow
  leavesRecommended LeaveRequest[] @relation("LeaveRecommender")
  leavesApproved    LeaveRequest[] @relation("LeaveApprover")
  
  transferredStaff   TransferLog[] @relation("StaffTransfers")
  transfersInitiated TransferLog[] @relation("TransferInitiator")
  
  // Phase 7 Relations
  requestedFiles     FileRequest[] @relation("RequestedFiles")
  approvedFiles      FileRequest[] @relation("ApprovedFiles")
  transferredFiles   FileRequest[] @relation("TransferredFiles")
  issuedQueries      StaffQuery[]  @relation("IssuedQueries")
  
  // Phase 12
  filesCreated       StaffProfile[] @relation("FileCreator")
  
  // Phase 13
  notifications      Notification[]

  // Phase 14 Memos
  sentMemos          Memo[]         @relation("SentMemos")
  receivedMemos      Memo[]         @relation("ReceivedMemos")
  memoResponses      MemoResponse[]

  // Clinic & Security Relations
  clinicPatientFile  ClinicPatientFile?
  securityRosters    SecurityRoster[]
  reportedIncidents  SecurityIncident[] @relation("IncidentReporter")
  assignedIncidents  SecurityIncident[] @relation("IncidentAssignee")
  securityReports    ConsolidatedSecurityReport[]
  fcmTokens          FcmToken[]
  paymentVouchers    PaymentVoucher[] @relation("PVCreator")
  securityGearLoans  SecurityGearLoan[]

  // Phase 16: Research Forum
  sentInvites        ProjectInvite[] @relation("Inviter")
  receivedInvites    ProjectInvite[] @relation("Invitee")
  projectMessages    ProjectMessage[]
  sessions           UserSession[]

  // Phase 17: Voicemail & Voice Notes
  sentVoicemails     Voicemail[]    @relation("SentVoicemails")
  receivedVoicemails Voicemail[]    @relation("ReceivedVoicemails")

  // Promotion Audit Logs
  promotionAuditLogs PromotionAuditLog[] @relation("PromotionAuditActor")

  // Official Registry Applications
  applicationsSubmitted    OfficialApplication[] @relation("ApplicantApplications")
  applicationsAcknowledged OfficialApplication[] @relation("AcknowledgedApplications")

  // Video Conferencing & Multi-Party Calls
  hostedCalls              CallSession[]         @relation("CallHost")
  callParticipations       CallParticipant[]     @relation("CallUser")
  callNotifications        CallNotification[]    @relation("CallNotificationRecipient")

  // Transfers Authorization (Registrar / Imputer-Authorizer)
  transfersAuthorized      TransferLog[]         @relation("TransferAuthorizer")

  // Academic Publications Vetted
  vettedPublications       AcademicPublication[] @relation("VettedPublications")

  // Dual-Control Maker-Checker Audit Trails
  imputedAuditTrails       AuthorizationAuditTrail[] @relation("ImputedAuditTrails")
  authorizedAuditTrails    AuthorizationAuditTrail[] @relation("AuthorizedAuditTrails")

  // Leave Dual-Level Authorization Workflow
  hodApprovedLeaves        LeaveApplication[] @relation("HodApprovedLeaves")
  registryApprovedLeaves   LeaveApplication[] @relation("RegistryApprovedLeaves")

  @@map("users")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  title     String
  message   String
  type      String   @default("INFO") // INFO, SUCCESS, WARNING, ERROR
  link      String?
  isRead    Boolean  @default(false)
  
  createdAt DateTime @default(now())

  @@map("notifications")
}

enum Role {
  SUPER_USER    // System Owner
  HR_ADMIN      // Registry HQ / HR Imputer
  REGISTRY_ADMIN // Registry Imputer / Operations Officer
  REGISTRAR     // Registrar / Principal Officer (Authorizer)
  DEPUTY_REGISTRAR // Authorized Delegate / Checker when designated
  UNIT_HEAD     // Director / Dean / HOD (Approver)
  UNIT_ADMIN    // Unit Admin (Recommender)
  BURSARY       // Finance
  AUDIT         // Audit
  STUDY_CENTER_MANAGER // Center Director (Special Unit Head)
  STAFF         // Regular Staff
  ADMIN         // Legacy System Admin (keep for safety)
  VICE_CHANCELLOR // Vice Chancellor
  CLINIC_HEAD
  CLINIC_NURSE
  CLINIC_DOCTOR
  CLINIC_PHARMACIST
  CLINIC_LAB_SCIENTIST
  SECURITY_HEAD
  SECURITY_OFFICER
  DRIVER
}

enum Cadre {
  ACADEMIC
  ADMINISTRATIVE
  TECHNICAL
  JUNIOR
  MEDICAL
  SECURITY
}

enum CadreType {
  ACADEMIC
  SENIOR_ADMIN
  JUNIOR_STAFF
  TECHNICAL
  MEDICAL
  SECURITY
}

enum EmploymentCategory {
  PERMANENT
  CONTRACT
  NYSC_CORPERS
  VOLUNTEER
}

enum TransferStatus {
  DRAFT
  PENDING_REGISTRAR_APPROVAL
  PENDING_REGISTRAR_AUTHORIZATION
  AUTHORIZED
  APPROVED
  REJECTED
  RETURNED_FOR_REVIEW
  CANCELLED
}

enum DisciplinaryActionType {
  QUERY
  OFFICIAL_WARNING
}

enum PromotionEligibilityStatus {
  PENDING_MATURITY
  DUE_FOR_REVIEW
  UNDER_EVALUATION
  APPROVED
  DEFERRED
  DISQUALIFIED_DISCIPLINARY
  PENDING_REGISTRAR_OVERRIDE
}

enum PublicationType {
  JOURNAL_ARTICLE
  CONFERENCE_PROCEEDING
  COURSE_MATERIAL
  ACADEMIC_BOOK
  BOOK_CHAPTER
}

enum PublicationVerificationStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

enum AcademicRank {
  ASSISTANT_LECTURER
  LECTURER_II
  LECTURER_I
  SENIOR_LECTURER
  ASSOCIATE_PROFESSOR
  PROFESSOR
}

enum HighestQualification {
  BACHELORS
  MASTERS
  PHD
}

enum UnitType {
  DIRECTORATE
  FACULTY
  DEPARTMENT
  STUDY_CENTER
}

model Unit {
  id        String   @id @default(uuid())
  name      String
  type      UnitType
  code      String?  @unique // e.g., "REG-HR"
  
  headId    String?
  // We could link head to User or StaffProfile. User is safer for Auth checks.
  
  staff                StaffProfile[]
  officialApplications OfficialApplication[]
  oldTransfers         TransferLog[]         @relation("TransferOldUnit")
  newTransfers         TransferLog[]         @relation("TransferNewUnit")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("units")
}

model StudyCenter {
  // Legacy model, keeping for backward compatibility but linked to Unit logic potentially
  // Or we eventually migrate StudyCenters to Units. For now, we keep both.
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  address   String?
  users     StaffProfile[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("study_centers")
}

model StaffProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  
  // Phase 3 Bio-data
  surname     String?
  otherNames  String?
  title       String?  // e.g. Mr, Mrs, Dr, Prof
  rank        String?  // e.g. Director, Dean, Senior Admin Officer
  staffId     String?  @unique // Indexed specifically
  highestQualification String? // e.g. Ph.D., M.Sc, B.Sc, HND, PGD, etc.
  
  level       String?  // e.g. "CONTISS 13"
  step        String?  // e.g. "2"
  cadre       Cadre?
  
  gender      String?
  phone       String?
  voipExtension String? // 4-digit internal VoIP extension (e.g., "1001")
  emailPersonal String? // Official email is in User model
  
  stateOfOrigin String?
  lga           String?
  address       String?
  
  passportUrl   String?
  
  // Organization
  department  Department? // Legacy Enum (keep for now)
  
  // Enhanced Organization
  unitId      String?
  unit        Unit?    @relation(fields: [unitId], references: [id])
  
  centerId    String?
  studyCenter StudyCenter? @relation(fields: [centerId], references: [id])
  
  // Diversified Onboarding (Permanent, Contract, NYSC, Volunteer)
  employmentCategory           EmploymentCategory @default(PERMANENT)
  contractStartDate            DateTime?
  contractEndDate              DateTime?
  contractRenewalTerms         String?            @db.Text
  specialAllowanceStructure    Json?
  callUpNumber                 String?
  stateCode                    String?
  primaryAssignmentDepartment  String?
  serviceYearBatch             String?
  nyscPPAAllowance             Float?
  passOutDate                  DateTime?
  volunteerProgramName         String?
  honorariumAmount             Float?
  engagementDurationMonths     Int?
  mouReferenceNumber           String?

  // Maker-Checker Account Clearance Gate
  accountStatus                String             @default("ACTIVE") // PENDING_REGISTRAR_CLEARANCE, CLEARED_ACTIVE, REJECTED
  isActivated                  Boolean            @default(true)
  clearanceSubmittedAt         DateTime?
  clearedAt                    DateTime?
  clearedById                  String?
  clearanceRemarks             String?            @db.Text

  // Statutory Leave Entitlements & Workflows
  isPrincipalOfficer           Boolean            @default(false)
  leaveBalances                LeaveBalance[]
  leaveApplications            LeaveApplication[] @relation("StaffLeaveApplications")
  reliefLeaveApplications      LeaveApplication[] @relation("ReliefStaffApplications")

  // Workflow
  leaves      LeaveRequest[]
  
  documents   Document[]   @relation("OwnerDocs")
  uploadedDocs Document[]  @relation("UploaderDocs")
  
  // Phase 7
  fileRequests FileRequest[] @relation("FileRequests")
  queries      StaffQuery[]  @relation("ReceivedQueries")
  
  // Phase 8
  publications Publication[]
  academicPublications AcademicPublication[]
  teaching     TeachingAllocation[]
  ippisNumber  String?  @unique // For Payroll Integration

  // Academic Promotion & Publication Engine Fields
  phdRegistrationProofUrl        String?
  phdGraduationDate              DateTime?
  currentAcademicRank            String?   // ASSISTANT_LECTURER, LECTURER_II, LECTURER_I, SENIOR_LECTURER, ASSOCIATE_PROFESSOR, PROFESSOR
  targetPromotionRank            String?   // Computed or set target rank
  totalVerifiedPublicationPoints Float     @default(0.0)

  // Phase 9: Academic & Facilitator
  programmeId     String?
  programme       AcademicProgramme? @relation(fields: [programmeId], references: [id])
  
  // Facilitator Details (Stored as JSON for flexibility: { isFacilitator: boolean, courses: [], ... })
  facilitatorInfo Json?

  // Phase 12: File Metadata
  createdById     String? // ID of HR/Admin who created this file
  createdBy       User?   @relation("FileCreator", fields: [createdById], references: [id])

  // Phase 13b: APER
  aperForms       AperForm[]

  // Promotion Tracking & Annual Maturity Subsystem
  dateOfLastPromotion   DateTime? // Retained for backward compatibility
  lastPromotionDate     DateTime? // Canonical promotion / appointment maturity date
  cadreType             CadreType?
  currentGradeLevel     String?   // e.g. CONUASS 04, CONTISS 11
  nextDueYear           Int?      // Indexed for fast annual eligibility queries
  nextDueDate           DateTime? // Exact maturity milestone date
  nextPromotionDueYear  Int?      // Explicit promotion milestone due year
  nextPromotionDueDate  DateTime? // Exact target promotion effective milestone date
  eligibilityStatus     PromotionEligibilityStatus @default(PENDING_MATURITY)
  promotionEligibilityStatus PromotionEligibilityStatus? @default(PENDING_MATURITY)
  legacyDataBackfilled  Boolean   @default(false) // Tracks if legacy records have been validated & backfilled
  registryOverride      Boolean   @default(false)
  overrideReason        String?   @db.Text
  evaluatedForYear      Int?

  // Registrar Authorization for Promotion Overrides & Disciplinary Hold
  promotionOverrideStatus           String?   // PENDING_REGISTRAR_OVERRIDE, APPROVED, REJECTED
  requestedPromotionDueYear         Int?
  promotionOverrideJustification    String?   @db.Text
  promotionOverrideRequestedById    String?
  promotionOverrideRequestedAt      DateTime?
  promotionOverrideApprovedById     String?
  promotionOverrideApprovedAt       DateTime?
  hasActiveDisciplinaryBlock        Boolean   @default(false)
  disciplinaryBlockReason           String?

  currentRank           String?   // Current rank/grade at time of flagging
  isDueForPromotion     Boolean   @default(false) // Registry-toggled flag
  promotionFlaggedAt    DateTime? // When Registry flagged this staff
  promotionFlaggedById  String?   // Who in Registry flagged them
  promotionLogs         PromotionLog[]
  promotionAuditLogs    PromotionAuditLog[]
  promotionCandidates   PromotionBatchCandidate[]

  // Statutory Retirement Tracking
  dateOfBirth              DateTime?
  dateOfFirstAppointment   DateTime?
  statutoryRetirementDate  DateTime?
  statutoryRetirementReason String? // AGE_LIMIT, YEARS_OF_SERVICE
  retirementAlertSentAt    DateTime? // Last time retirement alert was dispatched by cron
  retirementLogs           RetirementLog[]

  status      StaffStatus @default(ACTIVE)
  signatureUrl String?
  isDeleted   Boolean  @default(false)
  deletedAt   DateTime?

  // Phase 16: Research Forum Module
  ownedProjects ResearchProject[] @relation("ProjectOwner")
  projectMemberships ProjectMember[]
  projectFiles UploadedProjectFile[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bankName      String?
  accountNumber String?
  accountName   String?
  nin           String?

  @@map("staff_profiles")
  @@index([unitId])
  @@index([centerId])
  @@index([isDeleted])
  @@index([stateOfOrigin])
  @@index([status])
  @@index([isDueForPromotion])
  @@index([isDeleted, status])
  @@index([nextDueYear])
  @@index([nextPromotionDueYear])
  @@index([eligibilityStatus])
  @@index([promotionEligibilityStatus])
  @@index([cadreType])
  @@index([employmentCategory])
  @@index([employmentCategory, status])
  @@index([statutoryRetirementDate])
  @@index([accountStatus])
  @@index([cadreType, rank, dateOfBirth])
}

model AcademicProgramme {
  id        String   @id @default(uuid())
  title     String   // e.g. B.Sc. Computer Science
  code      String?  // e.g. 2201
  faculty   String   // e.g. Faculty of Sciences

  staff     StaffProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("academic_programmes")
}

model Publication {
  id          String   @id @default(uuid())
  staffId     String
  staff       StaffProfile @relation(fields: [staffId], references: [id])
  
  title       String
  citation    String?  // Full APA/MLA citation
  year        Int
  link        String?  // URL to DOI or PDF
  type        String   @default("ARTICLE") // ARTICLE, BOOK, CONFERENCE

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("publications")
}

model AcademicPublication {
  id                  String                        @id @default(uuid())
  staffId             String
  staff               StaffProfile                  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  
  title               String
  type                PublicationType               @default(JOURNAL_ARTICLE)
  doiOrIsbn           String?
  peerReviewed        Boolean                       @default(true)
  pointsClaimed       Float                         @default(0.0)
  pointsAwarded       Float                         @default(0.0)
  verificationStatus  PublicationVerificationStatus @default(PENDING_VERIFICATION)
  publicationDate     DateTime                      @default(now())
  year                Int?
  citation            String?                       @db.Text
  link                String?
  evidenceDocumentUrl String?
  indexingStatus      String?                       // e.g. Scopus, Web of Science, Institutional Repository
  
  vettedById          String?
  vettedBy            User?                         @relation("VettedPublications", fields: [vettedById], references: [id], onDelete: SetNull)
  vettedAt            DateTime?
  vettingRemarks      String?                       @db.Text
  
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt

  @@index([staffId])
  @@index([type])
  @@index([verificationStatus])
  @@index([doiOrIsbn])
  @@map("academic_publications")
}

model Course {
  id          String   @id @default(uuid())
  code        String   @unique // e.g., NOUN101
  title       String
  unit        Int
  semester    String   // FIRST, SECOND

  allocations TeachingAllocation[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("courses")
}

model TeachingAllocation {
  id          String   @id @default(uuid())
  
  staffId     String
  staff       StaffProfile @relation(fields: [staffId], references: [id])
  
  courseId    String
  course      Course       @relation(fields: [courseId], references: [id])
  
  session     String       // e.g., "2024/2025"
  students    Int          @default(0) // Number of students supervised/taught

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("teaching_allocations")
}

// ... Document Models (Keep existing) ...
enum Department {
  REGISTRY_MAIN
  REGISTRY_HR
  REGISTRY_ACADEMIC
  REGISTRY_COUNCIL
  REGISTRY_TRAINING
  BURSARY_MAIN
  BURSARY_PAYROLL
  BURSARY_AUDIT
  BURSARY_ACCOUNTS
  BURSARY_NHF
  BURSARY_EXPENDITURE
  STUDY_CENTER
  ACADEMIC_SCIENCES
  ACADEMIC_ARTS
  SECURITY_DEPARTMENT
  UNIVERSITY_CLINIC
}

enum DocumentType {
  APPOINTMENT_LETTER
  CREDENTIAL
  PROMOTION_LETTER
  PAYSLIP
  QUERY
  OTHER
}

enum AccessLevel {
  CONFIDENTIAL
  RESTRICTED
  PUBLIC
}

model Document {
  id              String        @id @default(uuid())
  ownerId         String
  owner           StaffProfile  @relation("OwnerDocs", fields: [ownerId], references: [id])
  
  type            DocumentType
  url             String
  title           String
  
  uploadedById    String
  uploadedBy      StaffProfile  @relation("UploaderDocs", fields: [uploadedById], references: [id])
  
  currentLocation Department   @default(REGISTRY_MAIN)
  accessLevel     AccessLevel  @default(CONFIDENTIAL)
  
  trail           DocumentTrail[]
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("documents")
}

model DocumentTrail {
  id          String      @id @default(uuid())
  documentId  String
  document    Document    @relation(fields: [documentId], references: [id])
  
  fromDept    Department
  toDept      Department
  
  actionById  String
  actionBy    User        @relation(fields: [actionById], references: [id])
  
  note        String?
  createdAt   DateTime    @default(now())

  @@map("document_trails")
}

// ... Audit & Logs ...

model AuditLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  
  action      String   // LOGIN, LOGOUT, TRANSFER, CREATE_STAFF
  resource    String   // USER, DOCUMENT, PAYROLL
  details     String?  // JSON string
  ipAddress   String?
  
  createdAt   DateTime @default(now())

  @@map("audit_logs")
  @@index([createdAt])
}

model TransferLog {
  // Renamed from PostingHistory
  id            String    @id @default(uuid())
  
  staffId       String
  staff         User      @relation("StaffTransfers", fields: [staffId], references: [id])
  
  oldCenterId   String?
  newCenterId   String?

  oldUnitId     String?
  oldUnit       Unit?     @relation("TransferOldUnit", fields: [oldUnitId], references: [id])
  newUnitId     String?
  newUnit       Unit?     @relation("TransferNewUnit", fields: [newUnitId], references: [id])

  status        TransferStatus @default(PENDING_REGISTRAR_AUTHORIZATION)
  relocationAllowance Boolean @default(false)
  relocationAllowanceAmount Float?
  isEffective   Boolean   @default(false)
  
  initiatedById String
  initiatedBy   User      @relation("TransferInitiator", fields: [initiatedById], references: [id])

  authorizedById String?
  authorizedBy   User?    @relation("TransferAuthorizer", fields: [authorizedById], references: [id])
  authorizedAt   DateTime?
  authorizationRemarks String? @db.Text
  rejectionReason String? @db.Text
  digitalSignatureRef String?
  transferLetterUrl   String?
  
  reason        String?
  effectiveDate DateTime  @default(now())
  applied       Boolean   @default(false)
  createdAt     DateTime  @default(now())

  @@map("transfer_logs")
  @@index([createdAt])
  @@index([staffId])
  @@index([status])
}

// ... HR Modules ...

enum LeaveStatus {
  PENDING
  RECOMMENDED
  APPROVED
  REJECTED
}

enum LeaveApplicationStatus {
  PENDING_HOD
  PENDING_REGISTRY
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  ANNUAL
  TERMINAL
  RESEARCH
  STUDY
  TRAINING
  CASUAL
  EXAMINATION
  EXTERNAL_ACADEMIC_AWARD
  SABBATICAL
  MATERNITY
  PATERNITY
  SICK
  LEAVE_OF_ABSENCE_WITHOUT_PAY
  WITHOUT_PAY // Legacy alias
}

model LeaveBalance {
  id                 String       @id @default(uuid())
  staffId            String
  staff              StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  leaveType          LeaveType
  year               Int
  totalDaysEntitled  Int
  daysUtilized       Int          @default(0)
  daysRemaining      Int
  isPaidLeave        Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([staffId, leaveType, year])
  @@index([staffId])
  @@index([year])
  @@map("leave_balances")
}

model LeaveApplication {
  id                      String                 @id @default(uuid())
  staffId                 String
  staff                   StaffProfile           @relation("StaffLeaveApplications", fields: [staffId], references: [id], onDelete: Cascade)
  leaveType               LeaveType
  startDate               DateTime
  endDate                 DateTime
  workingDaysCount        Int
  reliefStaffId           String?
  reliefStaff             StaffProfile?          @relation("ReliefStaffApplications", fields: [reliefStaffId], references: [id])
  status                  LeaveApplicationStatus @default(PENDING_HOD)
  reason                  String?                @db.Text
  supportingDocumentUrl   String?
  hodApprovalRemarks      String?                @db.Text
  hodApprovedById         String?
  hodApprovedBy           User?                  @relation("HodApprovedLeaves", fields: [hodApprovedById], references: [id])
  hodApprovedAt           DateTime?
  registryApprovalRemarks String?                @db.Text
  registryApprovedById    String?
  registryApprovedBy      User?                  @relation("RegistryApprovedLeaves", fields: [registryApprovedById], references: [id])
  registryApprovedAt      DateTime?
  isPrincipalOfficer      Boolean                @default(false)
  isPaidLeave             Boolean                @default(true)
  payrollSuspensionFlag   Boolean                @default(false)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@map("leave_applications")
  @@index([staffId])
  @@index([status])
  @@index([leaveType])
  @@index([startDate, endDate])
}

model UniversityHoliday {
  id         String   @id @default(uuid())
  date       DateTime @unique
  name       String
  isObserved Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("university_holidays")
  @@index([date])
}

model LeaveRequest {
  id          String      @id @default(uuid())
  
  staffId     String
  staff       StaffProfile @relation(fields: [staffId], references: [id])
  
  type        LeaveType
  startDate   DateTime
  endDate     DateTime
  durationDays Int
  
  reason      String
  
  status      LeaveStatus @default(PENDING)
  
  recommendedById String?
  recommendedBy   User?   @relation("LeaveRecommender", fields: [recommendedById], references: [id])
  
  approvedById    String?
  approvedBy      User?   @relation("LeaveApprover", fields: [approvedById], references: [id])
  
  rejectionReason String?
  
  // SLA & KPI Tracking
  submittedAt          DateTime    @default(now())
  expectedResolutionAt DateTime?
  resolvedAt           DateTime?
  turnaroundTimeHours  Float?
  slaBreach            Boolean     @default(false)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("leave_requests")
  @@index([staffId])
  @@index([status])
  @@index([endDate])
  @@index([slaBreach])
}

model Attendance {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  clockIn   DateTime  @default(now())
  clockOut  DateTime?
  latitude  Float?
  longitude Float?
  status    String    @default("PRESENT")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("attendance_logs")
  @@index([userId])
  @@index([clockIn])
  // Enterprise Scaling Rule: At 50,000+ users, this table is partitioned in PostgreSQL by RANGE on "clockIn".
  // SQL migration partitions are defined monthly (e.g. partition_y2026m07, partition_y2026m08).
}

model SalaryScale {
  id          String   @id @default(uuid())
  name        String   @unique // e.g. CONTISS, CONUASS
  description String?
  
  levels      SalaryLevel[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("salary_scales")
}

model SalaryLevel {
  id            String      @id @default(uuid())
  scaleId       String
  scale         SalaryScale @relation(fields: [scaleId], references: [id])
  
  level         String      // e.g. "07"
  step          String      // e.g. "01"
  
  basicSalary   Float
  rent          Float       @default(0)
  transport     Float       @default(0)
  meal          Float       @default(0)
  utility       Float       @default(0)
  entertainment Float       @default(0)

  consolidated  Float       // Total Annual/Monthly Gross

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([scaleId, level, step])
  @@map("salary_levels")
}

model Payroll {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  
  month             String
  year              Int
  
  // Earnings
  basicSalary       Float
  totalAllowances   Float
  grossPay          Float
  
  // Deductions
  tax               Float
  pension           Float
  otherDeductions   Float
  totalDeductions   Float
  
  netPay            Float
  
  status            String   @default("PENDING") // PENDING, APPROVED, PAID
  paymentDate       DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("payroll_records")
  @@unique([userId, month, year])
  @@index([month, year])
  // Enterprise Scaling Rule: At 50,000+ users, this table is partitioned in PostgreSQL by RANGE on "year" and "month".
  // SQL migration partitions are defined annually/monthly to maintain fast sub-second read queries for reporting.
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  RETURNED
}

model FileRequest {
  id          String        @id @default(uuid())
  requesterId String
  requester   User          @relation("RequestedFiles", fields: [requesterId], references: [id])
  
  staffId     String
  staff       StaffProfile  @relation("FileRequests", fields: [staffId], references: [id])
  
  reason      String?
  status      RequestStatus @default(PENDING)
  
  accessLink  String?       // Function generated secure link
  expiresAt   DateTime?

  approvedById   String?
  approvedBy     User?        @relation("ApprovedFiles", fields: [approvedById], references: [id])
  transferredById String?
  transferredBy  User?        @relation("TransferredFiles", fields: [transferredById], references: [id])
  
  // SLA & KPI Tracking
  submittedAt          DateTime    @default(now())
  expectedResolutionAt DateTime?
  resolvedAt           DateTime?
  turnaroundTimeHours  Float?
  slaBreach            Boolean     @default(false)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("file_requests")
  @@index([staffId])
  @@index([status])
  @@index([requesterId])
  @@index([slaBreach])
}

enum QueryStatus {
  OPEN
  RESPONDED
  CLOSED
  DEFAULTED_UNANSWERED
  REFERRED_TO_COMMITTEE
}

model StaffQuery {
  id          String      @id @default(uuid())
  
  staffId     String
  staff       StaffProfile @relation("ReceivedQueries", fields: [staffId], references: [id])
  
  issuedById  String
  issuedBy    User         @relation("IssuedQueries", fields: [issuedById], references: [id])
  
  title       String
  content     String      @db.Text

  // Unified Disciplinary Dispatch: Query vs Official Warning
  actionType           DisciplinaryActionType @default(QUERY)
  isQuery              Boolean                @default(true)
  isWarning            Boolean                @default(false)
  stipulatedHours      Int                    @default(48)
  responseDeadline     DateTime?
  slaBreached          Boolean                @default(false)
  slaBreachedAt        DateTime?
  source               String                 @default("REGISTRY") // REGISTRY, UNIT_HEAD, MANAGEMENT
  resolutionStatus     String                 @default("PENDING")  // PENDING, SATISFACTORY, UNSATISFACTORY, ABSORBED, EXONERATED, COMMITTEE_REFERRAL
  warningAcknowledged  Boolean                @default(false)
  warningAcknowledgedAt DateTime?
  disciplinaryCommitteeRef String?
  breachLoggedToFolio  Boolean                @default(false)
  
  response    String?     @db.Text
  responseAttachmentUrl String?
  
  status      QueryStatus @default(OPEN)
  copyHR      Boolean     @default(true)
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("staff_queries")
  @@index([staffId])
  @@index([status])
  @@index([copyHR])
  @@index([actionType])
  @@index([status, responseDeadline])
  @@index([source, resolutionStatus])
}

model SystemSequence {
  id        String   @id @default(uuid())
  key       String   @unique // e.g., "STAFF_ID"
  current   Int      @default(0)
  
  updatedAt DateTime @updatedAt

  @@map("system_sequences")
}

// Phase 13b: APER
model AperSession {
  id        String   @id @default(uuid())
  title     String   // e.g. "2025 Annual Appraisal"
  year      Int
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  
  // Automated Deadline Reminder Tracking
  reminder7DaysSentAt      DateTime?
  reminderClosingDaySentAt DateTime?
  reminder2HoursSentAt     DateTime?

  forms     AperForm[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("aper_sessions")
}

enum AperStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  COMPLETED
}

model AperForm {
  id          String      @id @default(uuid())
  
  staffId     String
  staff       StaffProfile @relation(fields: [staffId], references: [id])
  
  sessionId   String
  session     AperSession @relation(fields: [sessionId], references: [id])
  
  scores      Json?       // Structure: { kpi: { q1: 5, q2: 4... }, ethics: {...} }
  comments    Json?       // Comments from staff/supervisor
  
  status      AperStatus  @default(DRAFT)
  
  supervisorId String?
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([staffId, sessionId]) // One form per session per staff
  @@map("aper_forms")
  @@index([staffId])
  @@index([status])
}

model Memo {
  id             String         @id @default(uuid())
  title          String
  content        String         @db.Text
  allowResponses Boolean        @default(true)
  senderId       String
  sender         User           @relation("SentMemos", fields: [senderId], references: [id])
  recipientId    String?
  recipient      User?          @relation("ReceivedMemos", fields: [recipientId], references: [id])
  responses      MemoResponse[]
  attachmentUrl  String?
  attachmentName String?

  // Granular Routing & Target Audience Extension
  targetAudience String?        // ALL_STAFF, DIRECTORS_ONLY, DEANS_ONLY, DIRECTORS_AND_DEANS, HEADS_OF_DEPARTMENT_ONLY, STUDY_CENTER_DIRECTORS_ALL, CUSTOM_RECIPIENTS
  audienceRoles  Json?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("memos")
  @@index([senderId])
  @@index([recipientId])
  @@index([createdAt])
  @@index([targetAudience])
}

model MemoResponse {
  id        String   @id @default(uuid())
  memoId    String
  memo      Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)
  staffId   String
  staff     User     @relation(fields: [staffId], references: [id])
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@map("memo_responses")
}

model ClinicPatientFile {
  id                    String            @id @default(uuid())
  patientId             String            @unique // HR Employee ID or Student Matrix Number
  userId                String?           @unique // Optional link to authenticated User
  user                  User?             @relation(fields: [userId], references: [id])
  name                  String
  gender                String
  dob                   DateTime
  bloodGroup            String?
  genotype              String?
  allergies             String?
  encryptedMedicalHistory String          @db.Text // Encrypted clinical profile for strict privacy
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  encounters            ClinicEncounter[]

  @@map("clinic_patient_files")
}

model ClinicEncounter {
  id                String            @id @default(uuid())
  patientFileId     String
  patientFile       ClinicPatientFile @relation(fields: [patientFileId], references: [id], onDelete: Cascade)
  status            String            @default("TRIAGE") // TRIAGE, AWAITING_DOCTOR, CONSULTATION, LAB_REQUESTED, PHARMACY_REQUESTED, CLOSED
  
  // Triage details (Nurses)
  bp                String?
  temperature       Float?
  weight            Float?
  symptoms          String?           @db.Text
  triagedById       String?
  triagedAt         DateTime?
  
  // Consultation details (Doctors)
  clinicalNotes     String?           @db.Text
  diagnoses         String?           @db.Text
  consultedById     String?
  consultedAt       DateTime?
  
  // Lab Details
  labTests          String?           @db.Text // Requested tests
  labResults        String?           @db.Text // Uploaded/written results
  labScientistId    String?
  labCompletedAt    DateTime?
  
  // Pharmacy Details
  prescriptions     String?           @db.Text // Prescribed items
  pharmacyStatus    String            @default("PENDING") // PENDING, FULFILLED
  pharmacistId      String?
  pharmacyFulfilledAt DateTime?
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([patientFileId])
  @@index([status])
  @@map("clinic_encounters")
}

model ClinicInventory {
  id            String    @id @default(uuid())
  name          String    @unique
  quantity      Int
  unit          String    @default("tabs")
  expiryDate    DateTime?
  minStockLevel Int       @default(10)
  updatedAt     DateTime  @updatedAt

  @@map("clinic_inventory")
}

model SecurityRoster {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  shift        String   // MORNING, AFTERNOON, NIGHT
  zone         String   // Patrol zone
  date         DateTime
  assignedById String
  createdAt    DateTime @default(now())

  @@map("security_roster")
}

model SecurityIncident {
  id            String    @id @default(uuid())
  reporterId    String?
  reporter      User?     @relation("IncidentReporter", fields: [reporterId], references: [id])
  reporterName  String?   // For anonymous/external reports
  title         String
  description   String    @db.Text
  category      String    // THEFT, VANDALISM, MEDICAL_EMERGENCY, ASSAULT, SUSPICIOUS_ACTIVITY, OTHER
  priority      String    @default("LOW") // HIGH, MEDIUM, LOW
  location      String    // Campus location pin/name
  attachmentUrl String?
  status        String    @default("REPORTED") // REPORTED, DISPATCHED, RESOLVED
  assignedToId       String?
  assignedTo         User?     @relation("IncidentAssignee", fields: [assignedToId], references: [id])
  assignedOfficerIds String?   // Comma-separated list of assigned officer user IDs
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status])
  @@index([category])
  @@index([priority])
  @@index([createdAt])
  @@map("security_incidents")
}

model ConsolidatedSecurityReport {
  id                     String   @id @default(uuid())
  authorId               String
  author                 User     @relation(fields: [authorId], references: [id])
  startDate              DateTime
  endDate                DateTime
  summary                String   @db.Text
  totalIncidents         Int
  highPriorityIncidents  Int
  recommendations        String   @db.Text
  createdAt              DateTime @default(now())
  sentToVc               Boolean  @default(true)

  @@map("consolidated_security_reports")
}

// Promotion Monitoring Module — Audit Log
model PromotionLog {
  id                String   @id @default(uuid())

  staffProfileId    String
  staffProfile      StaffProfile @relation(fields: [staffProfileId], references: [id])

  // Snapshot at time of promotion trigger
  snapshotRank      String?  // rank when cron ran
  snapshotLevel     String?  // level/step when cron ran
  snapshotUnit      String?  // unit name when cron ran

  status            String   @default("DUE_FOR_PROMOTION") // DUE_FOR_PROMOTION, PROMOTED, WITHDRAWN
  calendarYear      Int      // The year the cron pushed this record (e.g. 2026)

  triggeredBy       String   @default("CRON") // CRON or MANUAL
  cronExecutedAt    DateTime @default(now())

  notes             String?  // Optional internal notes

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("promotion_logs")
  @@index([staffProfileId])
  @@index([calendarYear])
  @@index([status])
}

// Immutable Registry Promotion Audit Log for Schedule Overrides & Lifecycle Governance
model PromotionAuditLog {
  id              String                      @id @default(uuid())

  staffProfileId  String
  staffProfile    StaffProfile                @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  actorId         String
  actor           User                        @relation("PromotionAuditActor", fields: [actorId], references: [id])

  action          String                      // MANUAL_OVERRIDE, SCHEDULE_CONFIG, CRON_EVALUATED, STATUS_TRANSITION, DEFERRED, APPROVED_FOR_DOCKET
  previousDueYear Int?
  newDueYear      Int?
  previousStatus  PromotionEligibilityStatus?
  newStatus       PromotionEligibilityStatus?
  reason          String                      @db.Text
  metadata        Json?

  createdAt       DateTime                    @default(now())

  @@map("promotion_audit_logs")
  @@index([staffProfileId])
  @@index([actorId])
  @@index([createdAt])
  @@index([action])
}

// Annual Promotion Batch Docket Table
model PromotionBatch {
  id             String                    @id @default(uuid())
  cycleYear      Int                       @unique
  status         String                    @default("OPEN") // OPEN, SUBMITTED_TO_COUNCIL, CONCLUDED
  candidateCount Int                       @default(0)
  generatedAt    DateTime                  @default(now())
  notes          String?                   @db.Text

  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  candidates     PromotionBatchCandidate[]

  @@map("annual_promotion_batches")
  @@index([cycleYear])
  @@index([status])
}

// Candidates staged in the Annual Promotion Docket
model PromotionBatchCandidate {
  id                     String                     @id @default(uuid())

  batchId                String
  batch                  PromotionBatch             @relation(fields: [batchId], references: [id], onDelete: Cascade)

  staffProfileId         String
  staffProfile           StaffProfile               @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  cadreSnapshot          String?
  rankSnapshot           String?
  levelSnapshot          String?
  unitSnapshot           String?
  status                 PromotionEligibilityStatus @default(DUE_FOR_REVIEW)
  integrityClear         Boolean                    @default(true)
  disqualificationReason String?                    @db.Text

  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  @@unique([batchId, staffProfileId])
  @@map("promotion_batch_candidates")
  @@index([batchId])
  @@index([staffProfileId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
//  RETIREMENT TRACKING MODULE
// ─────────────────────────────────────────────────────────────────────────────

enum StaffStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  RETIRED
  DECEASED
  RESIGNED
  FIRED
}

model RetirementLog {
  id              String       @id @default(uuid())

  staffProfileId  String
  staffProfile    StaffProfile @relation(fields: [staffProfileId], references: [id])

  retirementDate  DateTime     // The calculated retirement date
  reason          String       // AGE_LIMIT | SERVICE_YEARS
  monthsAway      Int          // Months from alert date to retirement date
  alertSentAt     DateTime     @default(now())

  // Snapshot at time of alert
  snapshotName    String?
  snapshotStaffId String?
  snapshotUnit    String?

  createdAt       DateTime     @default(now())

  @@map("retirement_logs")
  @@index([staffProfileId])
  @@index([retirementDate])
}

model FcmToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

