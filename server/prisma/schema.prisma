  title           String
  amount          Float
  description     String
  category        String   // ALLOWANCE, TRAVEL, FUNDING, OTHER
  status          String   @default("PENDING") // PENDING, RECOMMENDED_BY_HEAD, AUDITED_BY_BURSARY, APPROVED, REJECTED
  unitId          String?  
  
  // Relationships
