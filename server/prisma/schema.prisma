  gearId     String
  gear       SecurityGear @relation(fields: [gearId], references: [id], onDelete: Cascade)
  officerId  String
  officer    User         @relation(fields: [officerId], references: [id], onDelete: Cascade)
  quantity   Int          @default(1)
  status     String       @default("LOANED") // LOANED, RETURNED
  loanedAt   DateTime     @default(now())
  returnedAt DateTime?

