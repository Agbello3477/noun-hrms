
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  
  // Phase 3 Roles
  role      Role     @default(STAFF)
  
  isActive  Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  tokenInvalidatedAt DateTime? // Set when account is archived; blocks all existing JWTs
  
  // Dual-Control Role Modification Fields (Maker-Checker Governance)
  pendingRole              Role?
  roleChangeStatus         String?   // 'PENDING_REGISTRAR_APPROVAL', 'APPROVED', 'REJECTED'
  roleChangeRequestedById  String?
  roleChangeRequestedAt    DateTime?
  roleChangeRemarks        String?
  
  // Phase 15: 2FA
  twoFactorSecret    String?
  isTwoFactorEnabled Boolean  @default(false)
  twoFactorBackupCodes String? @db.Text
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  staffProfile StaffProfile?

  attendance   Attendance[]
  payroll      Payroll[]
  
  actionTrails DocumentTrail[]
  auditLogs    AuditLog[]
  
  // Relations for Workflow
  leavesRecommended LeaveRequest[] @relation("LeaveRecommender")
  leavesApproved    LeaveRequest[] @relation("LeaveApprover")
  
  transferredStaff   TransferLog[] @relation("StaffTransfers")
  transfersInitiated TransferLog[] @relation("TransferInitiator")
  
  // Phase 7 Relations
  requestedFiles     FileRequest[] @relation("RequestedFiles")
  approvedFiles      FileRequest[] @relation("ApprovedFiles")
  transferredFiles   FileRequest[] @relation("TransferredFiles")
  issuedQueries      StaffQuery[]  @relation("IssuedQueries")
  
  // Phase 12
  filesCreated       StaffProfile[] @relation("FileCreator")
  
  // Phase 13
  notifications      Notification[]

  // Phase 14 Memos
  sentMemos          Memo[]         @relation("SentMemos")
  receivedMemos      Memo[]         @relation("ReceivedMemos")
  memoResponses      MemoResponse[]

  // Clinic & Security Relations
  clinicPatientFile  ClinicPatientFile?
  securityRosters    SecurityRoster[]
  reportedIncidents  SecurityIncident[] @relation("IncidentReporter")
  assignedIncidents  SecurityIncident[] @relation("IncidentAssignee")
  securityReports    ConsolidatedSecurityReport[]
  fcmTokens          FcmToken[]
  paymentVouchers    PaymentVoucher[] @relation("PVCreator")
  securityGearLoans  SecurityGearLoan[]

  // Phase 16: Research Forum
  sentInvites        ProjectInvite[] @relation("Inviter")
  receivedInvites    ProjectInvite[] @relation("Invitee")
  projectMessages    ProjectMessage[]
  sessions           UserSession[]

  // Phase 17: Voicemail & Voice Notes
  sentVoicemails     Voicemail[]    @relation("SentVoicemails")
  receivedVoicemails Voicemail[]    @relation("ReceivedVoicemails")

  // Promotion Audit Logs
  promotionAuditLogs PromotionAuditLog[] @relation("PromotionAuditActor")

  // Official Registry Applications
  applicationsSubmitted    OfficialApplication[] @relation("ApplicantApplications")
  applicationsAcknowledged OfficialApplication[] @relation("AcknowledgedApplications")

  // Video Conferencing & Multi-Party Calls
  hostedCalls              CallSession[]         @relation("CallHost")
  callParticipations       CallParticipant[]     @relation("CallUser")
  callNotifications        CallNotification[]    @relation("CallNotificationRecipient")

  // Transfers Authorization (Registrar / Imputer-Authorizer)
  transfersAuthorized      TransferLog[]         @relation("TransferAuthorizer")

  // Academic Publications Vetted
  vettedPublications       AcademicPublication[] @relation("VettedPublications")

  // Dual-Control Maker-Checker Audit Trails
  imputedAuditTrails       AuthorizationAuditTrail[] @relation("ImputedAuditTrails")
  authorizedAuditTrails    AuthorizationAuditTrail[] @relation("AuthorizedAuditTrails")

  // Leave Dual-Level Authorization Workflow
  hodApprovedLeaves        LeaveApplication[] @relation("HodApprovedLeaves")
  registryApprovedLeaves   LeaveApplication[] @relation("RegistryApprovedLeaves")

  // Institutional Multi-Tier Routing Workflow
  institutionalApplicationsSubmitted     InstitutionalApplication[]    @relation("InstitutionalApplicant")
  institutionalApplicationsDirected      InstitutionalApplication[]    @relation("InstitutionalDirector")
  institutionalApplicationsRegistrar     InstitutionalApplication[]    @relation("InstitutionalRegistrar")
  institutionalApplicationsDocketed      InstitutionalApplication[]    @relation("InstitutionalRegistryClerk")
  applicationRevisionsActed              ApplicationRevisionHistory[]  @relation("ApplicationRevisionActor")

  // File Requisition & Custody Tracking
  fileRequisitionsSubmitted              FileRequisition[]             @relation("FileRequisitionsSubmitted")
  fileRequisitionsAcknowledged           FileRequisition[]             @relation("FileRequisitionsAcknowledged")
  fileRequisitionsAuthorized             FileRequisition[]             @relation("FileRequisitionsAuthorized")
  fileRequisitionsDispatched             FileRequisition[]             @relation("FileRequisitionsDispatched")
  fileRequisitionsReceived               FileRequisition[]             @relation("FileRequisitionsReceived")
  fileCustodyAudits                      FileCustodyAuditTrail[]       @relation("FileCustodyAudits")

  // Academic Hierarchy & Workload Relations
  deanFaculties                          Faculty[]                     @relation("FacultyDean")
  facultyOfficerFaculties                Faculty[]                     @relation("FacultyOfficer")
  facultySecretaryFaculties              Faculty[]                     @relation("FacultySecretary")
  hodDepartments                         Department[]                  @relation("DepartmentHod")
  examOfficerDepartments                 Department[]                  @relation("DepartmentExamOfficer")
  adminOfficerDepartments                Department[]                  @relation("DepartmentAdmin")
  assignedWorkloads                      CourseWorkloadAllocation[]    @relation("AssignedWorkloads")
  approvedWorkloads                      CourseWorkloadAllocation[]    @relation("ApprovedWorkloads")
  ratifiedWorkloads                      CourseWorkloadAllocation[]    @relation("RatifiedWorkloads")
  staffWorkloadComplaints                WorkloadComplaint[]           @relation("StaffWorkloadComplaints")
  hodResolvedComplaints                  WorkloadComplaint[]           @relation("HodResolvedComplaints")

  // Statutory Compliance & Hardening Relations
  bondDischarges                         TrainingBondRecord[]          @relation("BondDischargedBy")
  authorizedDeferredLeaves               DeferredLeaveRecord[]         @relation("DeferredLeaveAuthorizer")
  postingsInitiated                      StaffPosting[]                @relation("StaffPostingInitiator")
  postingsAuthorized                     StaffPosting[]                @relation("StaffPostingAuthorizer")

  @@map("users")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  title     String
  message   String
  type      String   @default("INFO") // INFO, SUCCESS, WARNING, ERROR
  link      String?
  isRead    Boolean  @default(false)
  
  createdAt DateTime @default(now())

  @@map("notifications")
}

enum Role {
  SUPER_USER    // System Owner
  HR_ADMIN      // Registry HQ / HR Imputer
  REGISTRY_ADMIN // Registry Imputer / Operations Officer
  REGISTRAR     // Registrar / Principal Officer (Authorizer)
  DEPUTY_REGISTRAR // Authorized Delegate / Checker when designated
  UNIT_HEAD     // Director / Dean / HOD (Approver)
  UNIT_ADMIN    // Unit Admin (Recommender)
  BURSARY       // Finance
  AUDIT         // Audit
  STUDY_CENTER_MANAGER // Center Director (Special Unit Head)
  STAFF         // Regular Staff
  ADMIN         // Legacy System Admin (keep for safety)
  VICE_CHANCELLOR // Vice Chancellor
  CLINIC_HEAD
  CLINIC_NURSE
  CLINIC_DOCTOR
  CLINIC_PHARMACIST
  CLINIC_LAB_SCIENTIST
  SECURITY_HEAD
  SECURITY_OFFICER
  DRIVER
}

enum Cadre {
  ACADEMIC
  ADMINISTRATIVE
  TECHNICAL
  JUNIOR
  MEDICAL
  SECURITY
}

enum CadreType {
  ACADEMIC
  SENIOR_ADMIN
  JUNIOR_STAFF
  TECHNICAL
  MEDICAL
  SECURITY
}

enum EmploymentCategory {
  PERMANENT
  CONTRACT
  NYSC_CORPERS
  VOLUNTEER
}

enum TransferStatus {
  DRAFT
  PENDING_REGISTRAR_APPROVAL
  PENDING_REGISTRAR_AUTHORIZATION
  AUTHORIZED
  APPROVED
  REJECTED
  RETURNED_FOR_REVIEW
  CANCELLED
}

enum DisciplinaryActionType {
  QUERY
  OFFICIAL_WARNING
}

enum PromotionEligibilityStatus {
  PENDING_MATURITY
  DUE_FOR_REVIEW
  UNDER_EVALUATION
  APPROVED
  DEFERRED
  DISQUALIFIED_DISCIPLINARY
  PENDING_REGISTRAR_OVERRIDE
}

enum PublicationType {
  JOURNAL_ARTICLE
  CONFERENCE_PROCEEDING
  COURSE_MATERIAL
  ACADEMIC_BOOK
  BOOK_CHAPTER
}

enum PublicationVerificationStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

enum AcademicRank {
  ASSISTANT_LECTURER
  LECTURER_II
  LECTURER_I
  SENIOR_LECTURER
  ASSOCIATE_PROFESSOR
  PROFESSOR
}

enum HighestQualification {
  BACHELORS
  MASTERS
  PHD
}

enum UnitType {
  DIRECTORATE
  FACULTY
  DEPARTMENT
  STUDY_CENTER
}

model Unit {
  id        String   @id @default(uuid())
  name      String
  type      UnitType
  code      String?  @unique // e.g., "REG-HR"
  
  headId    String?
  // We could link head to User or StaffProfile. User is safer for Auth checks.
  
  staff                StaffProfile[]
  officialApplications OfficialApplication[]
  oldTransfers         TransferLog[]         @relation("TransferOldUnit")
  newTransfers         TransferLog[]         @relation("TransferNewUnit")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("units")
}

model StudyCenter {
  // Legacy model, keeping for backward compatibility but linked to Unit logic potentially
  // Or we eventually migrate StudyCenters to Units. For now, we keep both.
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  address   String?
  users     StaffProfile[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("study_centers")
}

model StaffProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  
  // Phase 3 Bio-data
  surname     String?
  otherNames  String?
  title       String?  // e.g. Mr, Mrs, Dr, Prof
  rank        String?  // e.g. Director, Dean, Senior Admin Officer
  staffId     String?  @unique // Indexed specifically
  highestQualification String? // e.g. Ph.D., M.Sc, B.Sc, HND, PGD, etc.
  
  level       String?  // e.g. "CONTISS 13"
  step        String?  // e.g. "2"
  cadre       Cadre?
  
  gender      String?
  phone       String?
  voipExtension String? // 4-digit internal VoIP extension (e.g., "1001")
  emailPersonal String? // Official email is in User model
  
  stateOfOrigin String?
  lga           String?
  address       String?
  
  passportUrl   String?
  
  // Organization
  department  LegacyDepartment? @map("department") // Legacy Enum (keep for backward compatibility)
  
  // Enhanced Organization
  unitId      String?
  unit        Unit?    @relation(fields: [unitId], references: [id])
  
  centerId    String?
  studyCenter StudyCenter? @relation(fields: [centerId], references: [id])
  
  // Diversified Onboarding (Permanent, Contract, NYSC, Volunteer)
  employmentCategory           EmploymentCategory @default(PERMANENT)
  contractStartDate            DateTime?
  contractEndDate              DateTime?
  contractRenewalTerms         String?            @db.Text
  specialAllowanceStructure    Json?
  callUpNumber                 String?
  stateCode                    String?
  primaryAssignmentDepartment  String?
  serviceYearBatch             String?
  nyscPPAAllowance             Float?
  passOutDate                  DateTime?
  volunteerProgramName         String?
  honorariumAmount             Float?
  engagementDurationMonths     Int?
  mouReferenceNumber           String?

  // Maker-Checker Account Clearance Gate
  accountStatus                String             @default("ACTIVE") // PENDING_REGISTRAR_CLEARANCE, CLEARED_ACTIVE, REJECTED
  isActivated                  Boolean            @default(true)
  clearanceSubmittedAt         DateTime?
  clearedAt                    DateTime?
  clearedById                  String?
  clearanceRemarks             String?            @db.Text

  // Statutory Leave Entitlements & Workflows
  isPrincipalOfficer           Boolean            @default(false)
  leaveBalances                LeaveBalance[]
  leaveApplications            LeaveApplication[] @relation("StaffLeaveApplications")
  reliefLeaveApplications      LeaveApplication[] @relation("ReliefStaffApplications")

  // Workflow
  leaves      LeaveRequest[]
  
  documents   Document[]   @relation("OwnerDocs")
  uploadedDocs Document[]  @relation("UploaderDocs")
  
  // Phase 7
  fileRequests FileRequest[] @relation("FileRequests")
  queries      StaffQuery[]  @relation("ReceivedQueries")
  
  // Phase 8
  publications Publication[]
  academicPublications AcademicPublication[]
  teaching     TeachingAllocation[]
  courseAllocations CourseWorkloadAllocation[]
  ippisNumber  String?  @unique // For Payroll Integration

  // Academic Promotion & Publication Engine Fields
  phdRegistrationProofUrl        String?
  phdGraduationDate              DateTime?
  currentAcademicRank            String?   // ASSISTANT_LECTURER, LECTURER_II, LECTURER_I, SENIOR_LECTURER, ASSOCIATE_PROFESSOR, PROFESSOR
  targetPromotionRank            String?   // Computed or set target rank
  totalVerifiedPublicationPoints Float     @default(0.0)

  // Phase 9: Academic & Facilitator
  programmeId     String?
  programme       AcademicProgramme? @relation(fields: [programmeId], references: [id])
  
  // Facilitator Details (Stored as JSON for flexibility: { isFacilitator: boolean, courses: [], ... })
  facilitatorInfo Json?

  // Phase 12: File Metadata
  createdById     String? // ID of HR/Admin who created this file
  createdBy       User?   @relation("FileCreator", fields: [createdById], references: [id])

  // Phase 13b: APER
  aperForms       AperForm[]

  // Promotion Tracking & Annual Maturity Subsystem
  dateOfLastPromotion   DateTime? // Retained for backward compatibility
  lastPromotionDate     DateTime? // Canonical promotion / appointment maturity date
  cadreType             CadreType?
  currentGradeLevel     String?   // e.g. CONUASS 04, CONTISS 11
  nextDueYear           Int?      // Indexed for fast annual eligibility queries
  nextDueDate           DateTime? // Exact maturity milestone date
  nextPromotionDueYear  Int?      // Explicit promotion milestone due year
  nextPromotionDueDate  DateTime? // Exact target promotion effective milestone date
  eligibilityStatus     PromotionEligibilityStatus @default(PENDING_MATURITY)
  promotionEligibilityStatus PromotionEligibilityStatus? @default(PENDING_MATURITY)
  legacyDataBackfilled  Boolean   @default(false) // Tracks if legacy records have been validated & backfilled
  registryOverride      Boolean   @default(false)
  overrideReason        String?   @db.Text
  evaluatedForYear      Int?

  // Registrar Authorization for Promotion Overrides & Disciplinary Hold
  promotionOverrideStatus           String?   // PENDING_REGISTRAR_OVERRIDE, APPROVED, REJECTED
  requestedPromotionDueYear         Int?
  promotionOverrideJustification    String?   @db.Text
  promotionOverrideRequestedById    String?
  promotionOverrideRequestedAt      DateTime?
  promotionOverrideApprovedById     String?
  promotionOverrideApprovedAt       DateTime?
  hasActiveDisciplinaryBlock        Boolean   @default(false)
  disciplinaryBlockReason           String?

  currentRank           String?   // Current rank/grade at time of flagging
  isDueForPromotion     Boolean   @default(false) // Registry-toggled flag
  promotionFlaggedAt    DateTime? // When Registry flagged this staff
  promotionFlaggedById  String?   // Who in Registry flagged them
  promotionLogs         PromotionLog[]
  promotionAuditLogs    PromotionAuditLog[]
  promotionCandidates   PromotionBatchCandidate[]

  // Statutory Retirement Tracking
  dateOfBirth              DateTime?
  dateOfFirstAppointment   DateTime?
  statutoryRetirementDate  DateTime?
  statutoryRetirementReason String? // AGE_LIMIT, YEARS_OF_SERVICE
  retirementAlertSentAt    DateTime? // Last time retirement alert was dispatched by cron
  retirementLogs           RetirementLog[]

  status      StaffStatus @default(ACTIVE)
  signatureUrl String?
  isDeleted   Boolean  @default(false)
  deletedAt   DateTime?

  // Phase 16: Research Forum Module
  ownedProjects ResearchProject[] @relation("ProjectOwner")
  projectMemberships ProjectMember[]
  projectFiles UploadedProjectFile[]

  // File Requisition & Custody Tracking
  fileRequisitions FileRequisition[] @relation("SubjectStaffFileRequisitions")

  // Statutory Compliance & Cadre Policy Hardening (2024 Conditions of Service)
  confirmationStatus           ConfirmationStatus @default(ON_PROBATION)
  probationStartDate           DateTime           @default(now())
  probationExtendedAt          DateTime?
  confirmedAt                  DateTime?
  spouseStaffId                String?
  spouse                       StaffProfile?      @relation("StaffSpouse", fields: [spouseStaffId], references: [id])
  spousalPartners              StaffProfile[]     @relation("StaffSpouse")
  isDisciplinaryInterdicted    Boolean            @default(false)
  isDisciplinarySuspended      Boolean            @default(false)
  annualBasicEmolument         Decimal?           @default(0.00) @db.Decimal(12, 2)
  trainingBonds                TrainingBondRecord[]
  deferredLeaves               DeferredLeaveRecord[]
  heldEmoluments               HeldEmolumentsLedger[]
  staffPostings                StaffPosting[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bankName      String?
  accountNumber String?
  accountName   String?
  nin           String?

  @@map("staff_profiles")
  @@index([unitId])
  @@index([centerId])
  @@index([isDeleted])
  @@index([stateOfOrigin])
  @@index([status])
  @@index([isDueForPromotion])
  @@index([isDeleted, status])
  @@index([nextDueYear])
  @@index([nextPromotionDueYear])
  @@index([eligibilityStatus])
  @@index([promotionEligibilityStatus])
  @@index([cadreType])
  @@index([employmentCategory])
  @@index([employmentCategory, status])
  @@index([statutoryRetirementDate])
  @@index([accountStatus])
  @@index([cadreType, rank, dateOfBirth])
  @@index([confirmationStatus])
  @@index([spouseStaffId])
}

enum ProgrammeLevel {
  UNDERGRADUATE
  POSTGRADUATE_DIPLOMA
  MASTERS
  DOCTORATE
}

enum AcademicSemester {
  FIRST_SEMESTER
  SECOND_SEMESTER
}

enum AllocationRole {
  COURSE_COORDINATOR
  LEAD_LECTURER
  CO_LECTURER
  PRACTICAL_INSTRUCTOR
}

enum WorkloadAllocationStatus {
  DRAFT
  SUBMITTED_BY_HOD
  APPROVED_BY_DEAN
  RATIFIED_ACADEMIC_PLANNING
}

model Faculty {
  id                 String              @id // Standardized code: agr, art, edu, hsc, law, msc, sci, ssc, cmp
  facultyCode        String              @unique // e.g. F01, F02, F03, ...
  name               String              // e.g. Faculty of Agricultural Sciences
  deanId             String?
  dean               User?               @relation("FacultyDean", fields: [deanId], references: [id], onDelete: SetNull)
  facultyOfficerId   String?
  facultyOfficer     User?               @relation("FacultyOfficer", fields: [facultyOfficerId], references: [id], onDelete: SetNull)
  facultySecretaryId String?
  facultySecretary   User?               @relation("FacultySecretary", fields: [facultySecretaryId], references: [id], onDelete: SetNull)
  departments        Department[]
  programmes         AcademicProgramme[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([facultyCode])
  @@map("faculties")
}

model Department {
  id                 String              @id // Standardized code: AEE, ASF, CSI, LNG, RST, ENG, etc.
  facultyId          String
  faculty            Faculty             @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  name               String              // e.g. Agricultural Economics And Extension
  code               String?             @unique // e.g. DEP-CS, DEP-LAW
  hodId              String?
  hod                User?               @relation("DepartmentHod", fields: [hodId], references: [id], onDelete: SetNull)
  examOfficerId      String?
  examOfficer        User?               @relation("DepartmentExamOfficer", fields: [examOfficerId], references: [id], onDelete: SetNull)
  departmentAdminId  String?
  departmentAdmin    User?               @relation("DepartmentAdmin", fields: [departmentAdminId], references: [id], onDelete: SetNull)
  programmes         AcademicProgramme[]
  courses            AcademicCourse[]
  complaints         WorkloadComplaint[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([facultyId])
  @@map("academic_departments")
}

model AcademicProgramme {
  id                   String            @id // Standardized programme id: e.g. AGR201, CMP201
  programmeCode        String            @unique // e.g. P010202
  name                 String            // e.g. B.Agric Agricultural Economics and Agro-Business
  degreeTitle          String            // e.g. B.Agric, B.Sc., B.A., PGD, M.Sc., Ph.D.
  programmeDescription String            @db.Text
  departmentId         String
  department           Department        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  facultyId            String
  faculty              Faculty           @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  level                ProgrammeLevel    @default(UNDERGRADUATE)
  isActive             Boolean           @default(true)
  courses              AcademicCourse[]
  staff                StaffProfile[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  // Legacy fields for backward compatibility
  title                String?
  code                 String?
  facultyName          String?

  @@index([departmentId])
  @@index([facultyId])
  @@index([programmeCode])
  @@map("academic_programmes")
}

model AcademicCourse {
  id             String                     @id @default(uuid())
  courseCode     String                     @unique // e.g. AEE 201, CMP 301
  courseTitle    String
  creditUnits    Int                        // 1–6
  lectureHours   Int                        @default(2)
  tutorialHours  Int                        @default(1)
  practicalHours Int                        @default(0)
  programmeId    String
  programme      AcademicProgramme          @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department                 @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  semester       AcademicSemester           @default(FIRST_SEMESTER)
  session        String                     @default("2026/2027") // e.g. "2026/2027"
  level          Int                        @default(100) // 100, 200, 300, 400, 500, 700, 800, 900
  allocations    CourseWorkloadAllocation[]
  complaints     WorkloadComplaint[]
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@index([departmentId])
  @@index([programmeId])
  @@index([semester, session])
  @@map("academic_courses")
}

model CourseWorkloadAllocation {
  id                          String                    @id @default(uuid())
  courseId                    String
  course                      AcademicCourse            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  academicStaffId             String
  academicStaff               StaffProfile              @relation(fields: [academicStaffId], references: [id], onDelete: Cascade)
  academicSession             String                    // e.g. "2026/2027"
  semester                    AcademicSemester          @default(FIRST_SEMESTER)
  role                        AllocationRole            @default(COURSE_COORDINATOR)
  assignedCreditUnits         Decimal                   @db.Decimal(4, 2)
  enrolledStudentsCount       Int                       @default(0)
  contactHoursWeekly          Decimal                   @db.Decimal(4, 2)
  allocationStatus            WorkloadAllocationStatus  @default(DRAFT)
  assignedById                String
  assignedBy                  User                      @relation("AssignedWorkloads", fields: [assignedById], references: [id])
  approvedById                String?
  approvedBy                  User?                     @relation("ApprovedWorkloads", fields: [approvedById], references: [id])
  ratifiedById                String?
  ratifiedBy                  User?                     @relation("RatifiedWorkloads", fields: [ratifiedById], references: [id])
  approvalRemarks             String?                   @db.Text
  courseMaterialCreditUnits   Decimal                   @default(0.0) @db.Decimal(4, 2)
  administrativeReliefUnits   Decimal                   @default(0.0) @db.Decimal(4, 2)
  effectiveTeachingEquivalent Decimal                   @default(0.0) @db.Decimal(6, 2)
  complaints                  WorkloadComplaint[]
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt

  @@unique([courseId, academicStaffId, academicSession, semester])
  @@index([academicStaffId, academicSession])
  @@index([allocationStatus])
  @@map("course_workload_allocations")
}

enum ComplaintStatus {
  PENDING_HOD_REVIEW
  UNDER_REVIEW
  RESOLVED_ADJUSTED
  REJECTED_MAINTAINED
}

model WorkloadComplaint {
  id                    String                    @id @default(uuid())
  staffId               String
  staff                 User                      @relation("StaffWorkloadComplaints", fields: [staffId], references: [id], onDelete: Cascade)
  departmentId          String
  department            Department                @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  allocationId          String?
  allocation            CourseWorkloadAllocation? @relation(fields: [allocationId], references: [id], onDelete: SetNull)
  courseId              String?
  course                AcademicCourse?           @relation(fields: [courseId], references: [id], onDelete: SetNull)
  
  session               String                    // e.g. "2026/2027"
  semester              AcademicSemester          @default(FIRST_SEMESTER)
  
  complaintType         String                    // "COURSE_MISMATCH", "EXCESSIVE_UNITS", "SCHEDULE_CLASH", "HEALTH_CONSTRAINT", "OTHER"
  subject               String
  details               String                    @db.Text
  suggestedAdjustment   String?                   @db.Text
  
  status                ComplaintStatus           @default(PENDING_HOD_REVIEW)
  hodRemarks            String?                   @db.Text
  resolvedById          String?
  resolvedBy            User?                     @relation("HodResolvedComplaints", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt            DateTime?
  
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@index([staffId])
  @@index([departmentId])
  @@index([status])
  @@map("workload_complaints")
}

model Publication {
  id          String   @id @default(uuid())
  staffId     String
  staff       StaffProfile @relation(fields: [staffId], references: [id])
  
  title       String
  citation    String?  // Full APA/MLA citation
  year        Int
  link        String?  // URL to DOI or PDF
  type        String   @default("ARTICLE") // ARTICLE, BOOK, CONFERENCE

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("publications")
}

model AcademicPublication {
  id                  String                        @id @default(uuid())
  staffId             String
  staff               StaffProfile                  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  
  title               String
  type                PublicationType               @default(JOURNAL_ARTICLE)
  doiOrIsbn           String?
  peerReviewed        Boolean                       @default(true)
  pointsClaimed       Float                         @default(0.0)
  pointsAwarded       Float                         @default(0.0)
  verificationStatus  PublicationVerificationStatus @default(PENDING_VERIFICATION)
  publicationDate     DateTime                      @default(now())
  year                Int?
  citation            String?                       @db.Text
  link                String?
