enum OfficialApplicationStatus {
  PENDING_ACKNOWLEDGMENT
  ACKNOWLEDGED
  IN_REVIEW
  APPROVED
  REJECTED
}

model OfficialApplication {
  id                 String                    @id @default(uuid())
  referenceNumber    String                    @unique
  applicantId        String
  applicant          User                      @relation("ApplicantApplications", fields: [applicantId], references: [id], onDelete: Cascade)
  applicantStaffId   String?
  applicantName      String
  applicantRank      String?
  applicantUnit      String?
  applicantRole      String?
  unitId             String?
  unit               Unit?                     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  targetDirectorate  String                    @default("CENTRAL_REGISTRY_HR")
  category           String                    @default("GENERAL_REQUEST")
  subject            String
  content            String                    @db.Text
  urgency            String                    @default("NORMAL")
  attachmentUrl      String?
  attachmentName     String?
  status             OfficialApplicationStatus @default(PENDING_ACKNOWLEDGMENT)
  // SLA & KPI Tracking
  submittedAt        DateTime                  @default(now())
  expectedResolutionAt DateTime?
  resolvedAt         DateTime?
  turnaroundTimeHours Float?
  slaBreach          Boolean                   @default(false)

  // Stamping & Acknowledgment by Registry
  acknowledgedById            String?
  acknowledgedBy              User?     @relation("AcknowledgedApplications", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  acknowledgedAt              DateTime?
  registryStampNumber         String?
  registryRemarks             String?   @db.Text
  registryOfficerName         String?
  registryOfficerDesignation  String?
  metadata                    Json?

  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([applicantId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@index([slaBreach])
  @@map("official_applications")
}

enum CallType {
  ONE_TO_ONE
  GROUP_DEPARTMENT
  EMERGENCY_DISPATCH
  CLINIC_CONSULT
}

enum CallSessionStatus {
  INITIATED
  ACTIVE
  ENDED
  CANCELLED
}

enum CallParticipationStatus {
  INVITED
  RINGING
  CONNECTED
  DECLINED
  MISSED
  LEFT
}

enum CallParticipantRole {
  HOST
  CO_HOST
  PARTICIPANT
}

enum CallNotificationType {
  CALL_IN_PROGRESS
  MISSED_CALL_SUMMARY
}

model CallSession {
  id              String             @id @default(uuid())
  roomId          String             @unique
  title           String?
  callType        CallType           @default(GROUP_DEPARTMENT)
  hostId          String
  host            User               @relation("CallHost", fields: [hostId], references: [id], onDelete: Cascade)
  departmentId    String?
  channelId       String?
  status          CallSessionStatus  @default(INITIATED)
  startedAt       DateTime           @default(now())
  endedAt         DateTime?
  durationSeconds Int                @default(0)
  metadata        Json?

  participants    CallParticipant[]
  notifications   CallNotification[]

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([roomId])
  @@index([hostId])
  @@index([status])
  @@index([departmentId])
  @@index([createdAt])
  @@map("call_sessions")
}

model CallParticipant {
  id                  String                  @id @default(uuid())
  callSessionId       String
  callSession         CallSession             @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  userId              String
  user                User                    @relation("CallUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedAt           DateTime                @default(now())
  joinedAt            DateTime?
  leftAt              DateTime?
  participationStatus CallParticipationStatus @default(INVITED)
  role                CallParticipantRole     @default(PARTICIPANT)

  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@unique([callSessionId, userId])
  @@index([callSessionId])
  @@index([userId])
  @@index([participationStatus])
  @@map("call_participants")
}

model CallNotification {
  id            String               @id @default(uuid())
  recipientId   String
  recipient     User                 @relation("CallNotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  callSessionId String
  callSession   CallSession          @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  type          CallNotificationType @default(MISSED_CALL_SUMMARY)
  metadata      Json?
  isRead        Boolean              @default(false)
  createdAt     DateTime             @default(now())

  @@index([recipientId])
  @@index([callSessionId])
  @@index([createdAt])
  @@map("call_notifications")
}

// ==========================================
// Dual-Control Maker-Checker Audit Trail Model
// ==========================================

enum AuthorizationEntityType {
  STAFF_POSTING
  FILE_CREATION
  PROMOTION_OVERRIDE
  DISCIPLINARY_SANCTION
  LEAVE_ESCALATION
  ROLE_CHANGE
}

enum AuthorizationActionTaken {
  APPROVED
  REJECTED
  RETURNED_TO_IMPUTER
}

model AuthorizationAuditTrail {
  id              String                   @id @default(uuid())
  entityType      AuthorizationEntityType
  entityId        String
  
  imputerId       String
  imputer         User                     @relation("ImputedAuditTrails", fields: [imputerId], references: [id])
  imputerIp       String?
  imputedAt       DateTime                 @default(now())
  
  authorizerId    String?
  authorizer      User?                    @relation("AuthorizedAuditTrails", fields: [authorizerId], references: [id])
  authorizerIp    String?
  authorizedAt    DateTime?
  
  actionTaken     AuthorizationActionTaken
  remarks         String?                  @db.Text
  digitalStampRef String?
  metadata        Json?
  
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@map("authorization_audit_trails")
  @@index([entityType, entityId])
  @@index([imputerId])
  @@index([authorizerId])
  @@index([actionTaken])
  @@index([createdAt])
}
