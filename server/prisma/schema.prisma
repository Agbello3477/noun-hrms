  REGISTRY_HR
  REGISTRY_ACADEMIC
  REGISTRY_COUNCIL
  REGISTRY_TRAINING
  BURSARY_MAIN
  BURSARY_PAYROLL
  BURSARY_AUDIT
  BURSARY_ACCOUNTS
  BURSARY_NHF
  BURSARY_EXPENDITURE
  STUDY_CENTER
  ACADEMIC_SCIENCES
  ACADEMIC_ARTS
  SECURITY_DEPARTMENT
  UNIVERSITY_CLINIC
  @@map("Department")
}

enum DocumentType {
  APPOINTMENT_LETTER
  CREDENTIAL
  PROMOTION_LETTER
  PAYSLIP
  QUERY
  OTHER
}

enum AccessLevel {
  CONFIDENTIAL
  RESTRICTED
  PUBLIC
}

model Document {
  id              String           @id @default(uuid())
  ownerId         String
  owner           StaffProfile     @relation("OwnerDocs", fields: [ownerId], references: [id])
  
  type            DocumentType
  url             String
  title           String
  
  uploadedById    String
  uploadedBy      StaffProfile     @relation("UploaderDocs", fields: [uploadedById], references: [id])
  
