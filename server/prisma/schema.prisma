}

model DocumentTrail {
  id          String           @id @default(uuid())
  documentId  String
  document    Document         @relation(fields: [documentId], references: [id])
  
  fromDept    LegacyDepartment
  toDept      LegacyDepartment
  
  actionById  String
  actionBy    User             @relation(fields: [actionById], references: [id])
  
  note        String?
  createdAt   DateTime         @default(now())
  
  @@map("document_trails")
}

// ... Audit & Logs ...

model AuditLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  
  action      String   // LOGIN, LOGOUT, TRANSFER, CREATE_STAFF
  resource    String   // USER, DOCUMENT, PAYROLL
  details     String?  // JSON string
  ipAddress   String?
  
  createdAt   DateTime @default(now())

  @@map("audit_logs")
  @@index([createdAt])
}

model TransferLog {
  // Renamed from PostingHistory
  id            String    @id @default(uuid())
  
  staffId       String
  staff         User      @relation("StaffTransfers", fields: [staffId], references: [id])
  
  oldCenterId   String?
  newCenterId   String?

  oldUnitId     String?
  oldUnit       Unit?     @relation("TransferOldUnit", fields: [oldUnitId], references: [id])
  newUnitId     String?
  newUnit       Unit?     @relation("TransferNewUnit", fields: [newUnitId], references: [id])

  status        TransferStatus @default(PENDING_REGISTRAR_AUTHORIZATION)
  relocationAllowance Boolean @default(false)
  relocationAllowanceAmount Float?
  isEffective   Boolean   @default(false)
  
  // Statutory Management Posting & Resettlement Fields
  isManagementInitiated       Boolean                   @default(true)
  resettlementAllowanceAmount Decimal?                  @default(0.00) @db.Decimal(10, 2)
  resettlementBursaryStatus   ResettlementBursaryStatus @default(NOT_APPLICABLE)
  spousalConflictDetected     Boolean                   @default(false)
  spousalConflictVcApprovalUrl String?

  initiatedById String
  initiatedBy   User      @relation("TransferInitiator", fields: [initiatedById], references: [id])

  authorizedById String?
  authorizedBy   User?    @relation("TransferAuthorizer", fields: [authorizedById], references: [id])
  authorizedAt   DateTime?
  authorizationRemarks String? @db.Text
  rejectionReason String? @db.Text
  digitalSignatureRef String?
  transferLetterUrl   String?
  
  reason        String?
  effectiveDate DateTime  @default(now())
  applied       Boolean   @default(false)
  createdAt     DateTime  @default(now())

  @@map("transfer_logs")
  @@index([createdAt])
  @@index([staffId])
  @@index([status])
}

// ... HR Modules ...

enum LeaveStatus {
  PENDING
  RECOMMENDED
  APPROVED
  REJECTED
}

enum LeaveApplicationStatus {
  PENDING_HOD
  PENDING_REGISTRY
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  ANNUAL
  TERMINAL
  RESEARCH
  STUDY
  TRAINING
  CASUAL
  EXAMINATION
  EXTERNAL_ACADEMIC_AWARD
  SABBATICAL
  MATERNITY
  PATERNITY
  SICK
  LEAVE_OF_ABSENCE_WITHOUT_PAY
  WITHOUT_PAY // Legacy alias
}

model LeaveBalance {
  id                 String       @id @default(uuid())
  staffId            String
  staff              StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  leaveType          LeaveType
  year               Int
  totalDaysEntitled  Int
  daysUtilized       Int          @default(0)
  daysRemaining      Int
  isPaidLeave        Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([staffId, leaveType, year])
  @@index([staffId])
  @@index([year])
  @@map("leave_balances")
}

model LeaveApplication {
  id                      String                 @id @default(uuid())
  staffId                 String
  staff                   StaffProfile           @relation("StaffLeaveApplications", fields: [staffId], references: [id], onDelete: Cascade)
  leaveType               LeaveType
  startDate               DateTime
  endDate                 DateTime
  workingDaysCount        Int
  reliefStaffId           String?
  reliefStaff             StaffProfile?          @relation("ReliefStaffApplications", fields: [reliefStaffId], references: [id])
  status                  LeaveApplicationStatus @default(PENDING_HOD)
  reason                  String?                @db.Text
  supportingDocumentUrl   String?
  hodApprovalRemarks      String?                @db.Text
  hodApprovedById         String?
  hodApprovedBy           User?                  @relation("HodApprovedLeaves", fields: [hodApprovedById], references: [id])
  hodApprovedAt           DateTime?
  registryApprovalRemarks String?                @db.Text
  registryApprovedById    String?
  registryApprovedBy      User?                  @relation("RegistryApprovedLeaves", fields: [registryApprovedById], references: [id])
  registryApprovedAt      DateTime?
  isPrincipalOfficer      Boolean                @default(false)
  isPaidLeave             Boolean                @default(true)
  payrollSuspensionFlag   Boolean                @default(false)
  
  trainingBonds           TrainingBondRecord[]

  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@map("leave_applications")
  @@index([staffId])
  @@index([status])
  @@index([leaveType])
  @@index([startDate, endDate])
}

model LeaveSession {
  id        String   @id @default(uuid())
  title     String   // e.g. "2026 Annual Statutory Leave Exercise"
  year      Int      @unique
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  
  // Automated Deadline Reminder Tracking
  reminder7DaysSentAt      DateTime?
  reminderClosingDaySentAt DateTime?
  reminder2HoursSentAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("leave_sessions")
}

model UniversityHoliday {
  id         String   @id @default(uuid())
  date       DateTime @unique
  name       String
  isObserved Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("university_holidays")
  @@index([date])
}

model LeaveRequest {
  id          String      @id @default(uuid())
  
  staffId     String
  staff       StaffProfile @relation(fields: [staffId], references: [id])
  
  type        LeaveType
  startDate   DateTime
  endDate     DateTime
  durationDays Int
  
  reason      String
  
  status      LeaveStatus @default(PENDING)
  
  recommendedById String?
  recommendedBy   User?   @relation("LeaveRecommender", fields: [recommendedById], references: [id])
  
  approvedById    String?
  approvedBy      User?   @relation("LeaveApprover", fields: [approvedById], references: [id])
  
  rejectionReason String?
  
  // SLA & KPI Tracking
  submittedAt          DateTime    @default(now())
  expectedResolutionAt DateTime?
  resolvedAt           DateTime?
  turnaroundTimeHours  Float?
  slaBreach            Boolean     @default(false)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("leave_requests")
  @@index([staffId])
  @@index([status])
  @@index([endDate])
  @@index([slaBreach])
}

model Attendance {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  clockIn   DateTime  @default(now())
  clockOut  DateTime?
  latitude  Float?
  longitude Float?
  status    String    @default("PRESENT")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("attendance_logs")
  @@index([userId])
  @@index([clockIn])
  // Enterprise Scaling Rule: At 50,000+ users, this table is partitioned in PostgreSQL by RANGE on "clockIn".
  // SQL migration partitions are defined monthly (e.g. partition_y2026m07, partition_y2026m08).
}

model SalaryScale {
  id          String   @id @default(uuid())
  name        String   @unique // e.g. CONTISS, CONUASS
  description String?
  
  levels      SalaryLevel[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("salary_scales")
}

model SalaryLevel {
  id            String      @id @default(uuid())
  scaleId       String
  scale         SalaryScale @relation(fields: [scaleId], references: [id])
  
  level         String      // e.g. "07"
  step          String      // e.g. "01"
  
  basicSalary   Float
  rent          Float       @default(0)
  transport     Float       @default(0)
  meal          Float       @default(0)
  utility       Float       @default(0)
  entertainment Float       @default(0)

  consolidated  Float       // Total Annual/Monthly Gross

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([scaleId, level, step])
  @@map("salary_levels")
}

model Payroll {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  
  month             String
  year              Int
  
  // Earnings
  basicSalary       Float
  totalAllowances   Float
  grossPay          Float
  
  // Deductions
  tax               Float
  pension           Float
  otherDeductions   Float
  totalDeductions   Float
  
  netPay            Float
  
  status            String   @default("PENDING") // PENDING, APPROVED, PAID
  paymentDate       DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("payroll_records")
  @@unique([userId, month, year])
  @@index([month, year])
  // Enterprise Scaling Rule: At 50,000+ users, this table is partitioned in PostgreSQL by RANGE on "year" and "month".
  // SQL migration partitions are defined annually/monthly to maintain fast sub-second read queries for reporting.
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  RETURNED
}

model FileRequest {
  id          String        @id @default(uuid())
  requesterId String
  requester   User          @relation("RequestedFiles", fields: [requesterId], references: [id])
  
  staffId     String
  staff       StaffProfile  @relation("FileRequests", fields: [staffId], references: [id])
  
  reason      String?
  status      RequestStatus @default(PENDING)
  
  accessLink  String?       // Function generated secure link
  expiresAt   DateTime?

  approvedById   String?
  approvedBy     User?        @relation("ApprovedFiles", fields: [approvedById], references: [id])
  transferredById String?
  transferredBy  User?        @relation("TransferredFiles", fields: [transferredById], references: [id])
  
  // SLA & KPI Tracking
  submittedAt          DateTime    @default(now())
  expectedResolutionAt DateTime?
  resolvedAt           DateTime?
  turnaroundTimeHours  Float?
  slaBreach            Boolean     @default(false)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("file_requests")
  @@index([staffId])
  @@index([status])
  @@index([requesterId])
  @@index([slaBreach])
}

enum QueryStatus {
  OPEN
  RESPONDED
  CLOSED
  DEFAULTED_UNANSWERED
  REFERRED_TO_COMMITTEE
}

model StaffQuery {
  id          String      @id @default(uuid())
  
  staffId     String
  staff       StaffProfile @relation("ReceivedQueries", fields: [staffId], references: [id])
  
  issuedById  String
  issuedBy    User         @relation("IssuedQueries", fields: [issuedById], references: [id])
  
  title       String
  content     String      @db.Text

  // Unified Disciplinary Dispatch: Query vs Official Warning
  actionType           DisciplinaryActionType @default(QUERY)
  isQuery              Boolean                @default(true)
  isWarning            Boolean                @default(false)
  stipulatedHours      Int                    @default(48)
  responseDeadline     DateTime?
  slaBreached          Boolean                @default(false)
  slaBreachedAt        DateTime?
  source               String                 @default("REGISTRY") // REGISTRY, UNIT_HEAD, MANAGEMENT
  resolutionStatus     String                 @default("PENDING")  // PENDING, SATISFACTORY, UNSATISFACTORY, ABSORBED, EXONERATED, COMMITTEE_REFERRAL
  warningAcknowledged  Boolean                @default(false)
  warningAcknowledgedAt DateTime?
  disciplinaryCommitteeRef String?
  breachLoggedToFolio  Boolean                @default(false)
  
  response    String?     @db.Text
  responseAttachmentUrl String?
  
  status      QueryStatus @default(OPEN)
  copyHR      Boolean     @default(true)
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("staff_queries")
  @@index([staffId])
  @@index([status])
  @@index([copyHR])
  @@index([actionType])
  @@index([status, responseDeadline])
  @@index([source, resolutionStatus])
}

model SystemSequence {
  id        String   @id @default(uuid())
  key       String   @unique // e.g., "STAFF_ID"
  current   Int      @default(0)
  
  updatedAt DateTime @updatedAt

  @@map("system_sequences")
}

// Phase 13b: APER
model AperSession {
  id        String   @id @default(uuid())
  title     String   // e.g. "2025 Annual Appraisal"
  year      Int
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  
  // Automated Deadline Reminder Tracking
  reminder7DaysSentAt      DateTime?
  reminderClosingDaySentAt DateTime?
  reminder2HoursSentAt     DateTime?

  forms     AperForm[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("aper_sessions")
}

enum AperStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  COMPLETED
}

model AperForm {
  id          String      @id @default(uuid())
  
  staffId     String
  staff       StaffProfile @relation(fields: [staffId], references: [id])
  
  sessionId   String
  session     AperSession @relation(fields: [sessionId], references: [id])
  
  scores      Json?       // Structure: { kpi: { q1: 5, q2: 4... }, ethics: {...} }
  comments    Json?       // Comments from staff/supervisor
  
  status      AperStatus  @default(DRAFT)
  
  supervisorId String?
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([staffId, sessionId]) // One form per session per staff
  @@map("aper_forms")
  @@index([staffId])
  @@index([status])
}

model Memo {
  id             String         @id @default(uuid())
  title          String
  content        String         @db.Text
  allowResponses Boolean        @default(true)
  senderId       String
  sender         User           @relation("SentMemos", fields: [senderId], references: [id])
  recipientId    String?
  recipient      User?          @relation("ReceivedMemos", fields: [recipientId], references: [id])
  responses      MemoResponse[]
  attachmentUrl  String?
  attachmentName String?

  // Granular Routing & Target Audience Extension
  targetAudience String?        // ALL_STAFF, DIRECTORS_ONLY, DEANS_ONLY, DIRECTORS_AND_DEANS, HEADS_OF_DEPARTMENT_ONLY, STUDY_CENTER_DIRECTORS_ALL, CUSTOM_RECIPIENTS
  audienceRoles  Json?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("memos")
  @@index([senderId])
  @@index([recipientId])
  @@index([createdAt])
  @@index([targetAudience])
}

model MemoResponse {
  id        String   @id @default(uuid())
  memoId    String
  memo      Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)
  staffId   String
  staff     User     @relation(fields: [staffId], references: [id])
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@map("memo_responses")
}

model ClinicPatientFile {
  id                    String            @id @default(uuid())
  patientId             String            @unique // HR Employee ID or Student Matrix Number
  userId                String?           @unique // Optional link to authenticated User
  user                  User?             @relation(fields: [userId], references: [id])
  name                  String
  gender                String
  dob                   DateTime
  bloodGroup            String?
  genotype              String?
  allergies             String?
  encryptedMedicalHistory String          @db.Text // Encrypted clinical profile for strict privacy
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  encounters            ClinicEncounter[]

  @@map("clinic_patient_files")
}

model ClinicEncounter {
  id                String            @id @default(uuid())
  patientFileId     String
  patientFile       ClinicPatientFile @relation(fields: [patientFileId], references: [id], onDelete: Cascade)
  status            String            @default("TRIAGE") // TRIAGE, AWAITING_DOCTOR, CONSULTATION, LAB_REQUESTED, PHARMACY_REQUESTED, CLOSED
  
  // Triage details (Nurses)
  bp                String?
  temperature       Float?
  weight            Float?
  symptoms          String?           @db.Text
  triagedById       String?
  triagedAt         DateTime?
  
  // Consultation details (Doctors)
  clinicalNotes     String?           @db.Text
  diagnoses         String?           @db.Text
  consultedById     String?
  consultedAt       DateTime?
  
  // Lab Details
  labTests          String?           @db.Text // Requested tests
  labResults        String?           @db.Text // Uploaded/written results
  labScientistId    String?
  labCompletedAt    DateTime?
  
  // Pharmacy Details
  prescriptions     String?           @db.Text // Prescribed items
  pharmacyStatus    String            @default("PENDING") // PENDING, FULFILLED
  pharmacistId      String?
  pharmacyFulfilledAt DateTime?
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([patientFileId])
  @@index([status])
  @@map("clinic_encounters")
