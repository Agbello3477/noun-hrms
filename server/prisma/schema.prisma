model AiLearnedInsight {
  id                    String   @id @default(uuid())
  topic                 String   // e.g. "LEAVE_CARRYOVER", "PROMOTION_WAITING_PERIOD", "WORKLOAD_REBATES", "DOCKET_ROUTING"
  triggerPattern        String   // Search keywords or regex pattern
