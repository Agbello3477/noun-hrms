  @@index([gearId])
  @@index([officerId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
//  RESEARCH FORUM MODULE (COLLABORATIVE RESEARCH)
// ─────────────────────────────────────────────────────────────────────────────

model ResearchProject {
  id          String   @id @default(uuid())
  title       String
  abstract    String?  @db.Text
  domain      String?
  status      String   @default("DRAFT") // DRAFT, ONGOING, COMPLETED
  
  ownerId     String
  owner       StaffProfile @relation("ProjectOwner", fields: [ownerId], references: [id])
  
  members     ProjectMember[]
  invites     ProjectInvite[]
  documents   ProjectDocument[]
  messages    ProjectMessage[]
  files       UploadedProjectFile[]
  grants      ResearchGrant[]
  ipRecords   IntellectualProperty[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("research_projects")
  @@index([ownerId])
  @@index([status])
}

model ProjectMember {
  id          String   @id @default(uuid())
  projectId   String
  project     ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  staffId     String
  staff       StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  
  role        String   @default("EDITOR") // OWNER, EDITOR, VIEWER
  
  joinedAt    DateTime @default(now())

  @@map("project_members")
  @@index([projectId])
  @@index([staffId])
  @@unique([projectId, staffId])
}

model ProjectInvite {
  id          String   @id @default(uuid())
  projectId   String
  project     ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  inviterId   String
  inviter     User     @relation("Inviter", fields: [inviterId], references: [id], onDelete: Cascade)
  
  inviteeId   String
  invitee     User     @relation("Invitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  
  status      String   @default("PENDING") // PENDING, ACCEPTED, DECLINED
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("project_invites")
  @@index([projectId])
  @@index([inviteeId])
}

model ProjectDocument {
  id          String   @id @default(uuid())
  projectId   String
  project     ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  title       String   @default("Untitled Document")
  contentHtml String?  @db.Text  // Rich text HTML saved by TipTap editor
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("project_documents")
  @@index([projectId])
}

model ProjectMessage {
  id          String   @id @default(uuid())
  projectId   String
  project     ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  senderId    String
  sender      User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  
  text        String   @db.Text
  
  createdAt   DateTime @default(now())

  @@map("project_messages")
  @@index([projectId])
  @@index([createdAt])
}

model UploadedProjectFile {
  id          String   @id @default(uuid())
  projectId   String
  project     ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  uploaderId  String
  uploader    StaffProfile @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  
  fileName    String
  fileUrl     String
  mimeType    String
  
  uploadedAt  DateTime @default(now())

  @@map("project_files")
  @@index([projectId])
}

model UserSession {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique @db.Text
  ipAddress  String?
  userAgent  String?
  lastActive DateTime @default(now())
  createdAt  DateTime @default(now())

  @@map("user_sessions")
}

model ResearchGrant {
  id              String   @id @default(uuid())
  projectId       String
  project         ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  grantorName     String
  totalFunding    Float
  disbursedAmount Float    @default(0)
  startDate       DateTime
  endDate         DateTime
  milestones      Json?    // Array of { id, title, targetDate, status, releasedAmount }
