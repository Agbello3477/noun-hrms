  authorId               String
  author                 User     @relation(fields: [authorId], references: [id])
  startDate              DateTime
  endDate                DateTime
  summary                String   @db.Text
  totalIncidents         Int
  highPriorityIncidents  Int
  recommendations        String   @db.Text
  createdAt              DateTime @default(now())
  sentToVc               Boolean  @default(true)

  @@map("consolidated_security_reports")
}

// Promotion Monitoring Module — Audit Log
model PromotionLog {
  id                String   @id @default(uuid())

  staffProfileId    String
  staffProfile      StaffProfile @relation(fields: [staffProfileId], references: [id])

  // Snapshot at time of promotion trigger
  snapshotRank      String?  // rank when cron ran
  snapshotLevel     String?  // level/step when cron ran
  snapshotUnit      String?  // unit name when cron ran

  status            String   @default("DUE_FOR_PROMOTION") // DUE_FOR_PROMOTION, PROMOTED, WITHDRAWN
  calendarYear      Int      // The year the cron pushed this record (e.g. 2026)

  triggeredBy       String   @default("CRON") // CRON or MANUAL
  cronExecutedAt    DateTime @default(now())

  notes             String?  // Optional internal notes

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("promotion_logs")
  @@index([staffProfileId])
  @@index([calendarYear])
  @@index([status])
}

// Immutable Registry Promotion Audit Log for Schedule Overrides & Lifecycle Governance
model PromotionAuditLog {
  id              String                      @id @default(uuid())

  staffProfileId  String
  staffProfile    StaffProfile                @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  actorId         String
  actor           User                        @relation("PromotionAuditActor", fields: [actorId], references: [id])

  action          String                      // MANUAL_OVERRIDE, SCHEDULE_CONFIG, CRON_EVALUATED, STATUS_TRANSITION, DEFERRED, APPROVED_FOR_DOCKET
  previousDueYear Int?
  newDueYear      Int?
  previousStatus  PromotionEligibilityStatus?
  newStatus       PromotionEligibilityStatus?
  reason          String                      @db.Text
  metadata        Json?

  createdAt       DateTime                    @default(now())

