  @@index([status])
}

model SecurityGear {
  id           String             @id @default(uuid())
  name         String             @unique
  totalQty     Int
  availableQty Int
  unit         String             @default("pcs")
  updatedAt    DateTime           @updatedAt
  loans        SecurityGearLoan[]

