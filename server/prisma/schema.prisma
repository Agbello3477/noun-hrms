enum CallType {
  ONE_TO_ONE
  GROUP_DEPARTMENT
  EMERGENCY_DISPATCH
  CLINIC_CONSULT
}

enum CallSessionStatus {
  INITIATED
  ACTIVE
  ENDED
  CANCELLED
}

enum CallParticipationStatus {
  INVITED
  RINGING
  CONNECTED
  DECLINED
  MISSED
  LEFT
}

enum CallParticipantRole {
  HOST
  CO_HOST
  PARTICIPANT
}

enum CallNotificationType {
  CALL_IN_PROGRESS
  MISSED_CALL_SUMMARY
}

model CallSession {
  id              String             @id @default(uuid())
  roomId          String             @unique
  title           String?
  callType        CallType           @default(GROUP_DEPARTMENT)
  hostId          String
  host            User               @relation("CallHost", fields: [hostId], references: [id], onDelete: Cascade)
  departmentId    String?
  channelId       String?
