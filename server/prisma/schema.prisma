  projectId        String
  project          ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title            String
  patentAppNumber  String?
  inventors        Json?    // Array of { name, role: 'STAFF'|'STUDENT'|'OTHER', id? }
  status           String   @default("PENDING") // PENDING, GRANTED, LICENSED
  doiLink          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("intellectual_properties")
}

model Voicemail {
  id                 String   @id @default(uuid())
  callerUserId       String
  callerUser         User     @relation("SentVoicemails", fields: [callerUserId], references: [id], onDelete: Cascade)
  recipientUserId    String
  recipientUser      User     @relation("ReceivedVoicemails", fields: [recipientUserId], references: [id], onDelete: Cascade)
  callerExtension    String
  recipientExtension String
  audioUrl           String
  durationSeconds    Int      @default(0)
  isListened         Boolean  @default(false)
  createdAt          DateTime @default(now())

